<Window x:Class="RepoRecon.App.Views.RollbackConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="이 커밋으로 되돌리기 확인"
        Height="300" Width="520"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="DialogRollbackConfirm"
        Background="{StaticResource NeutralSurface}"
        FontFamily="{StaticResource FontFamilyDefault}"
        Foreground="{StaticResource NeutralForeground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Warning Header -->
        <Border Grid.Row="0"
                Background="{StaticResource ErrorBackground}"
                BorderBrush="{StaticResource ErrorBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="⚠️ 주의: 로컬 작업트리 하드 리셋 (git reset --hard)" FontWeight="Bold" FontSize="{StaticResource FontSizeSubtitle}" Foreground="{StaticResource ErrorForeground}" />
                <TextBlock Text="선택한 커밋 시점으로 HEAD 및 로컬 인덱스를 강제 복구합니다. 미커밋 변경 사항이 있으면 차단됩니다." FontSize="{StaticResource FontSizeSecondary}" Foreground="{StaticResource ErrorForeground}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Commit & Path Details -->
        <Border Grid.Row="1"
                Background="{StaticResource NeutralBackground}"
                BorderBrush="{StaticResource NeutralBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="대상 저장소:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtTargetPath" AutomationProperties.AutomationId="TxtRollbackTargetPath" FontFamily="{StaticResource FontFamilyMono}" Foreground="{StaticResource NeutralForeground}" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="되돌릴 커밋:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtCommitHash" AutomationProperties.AutomationId="TxtRollbackCommitHash" FontFamily="{StaticResource FontFamilyMono}" FontWeight="Bold" Foreground="{StaticResource InfoForeground}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bottom Buttons: 위험 동작이므로 기본 버튼은 취소 쪽 (§5-1) -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right"
                    x:Name="BtnConfirmRollback"
                    AutomationProperties.AutomationId="BtnConfirmRollback"
                    Content="되돌리기 실행"
                    Click="BtnConfirm_Click"
                    Padding="16,8"
                    Style="{StaticResource DangerButtonStyle}" />

            <Button DockPanel.Dock="Right"
                    x:Name="BtnCancelRollback"
                    AutomationProperties.AutomationId="BtnCancelRollback"
                    Content="취소"
                    Click="BtnCancel_Click"
                    IsCancel="True"
                    IsDefault="True"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
