<Window x:Class="RepoRecon.App.Views.RollbackConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="이 커밋으로 되돌리기 확인"
        Height="300" Width="520"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="DialogRollbackConfirm"
        Background="#F8FAFC">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Warning Header -->
        <Border Grid.Row="0"
                Background="#FEF2F2"
                BorderBrush="#FCA5A5"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="⚠️ 주의: 로컬 작업트리 하드 리셋 (git reset --hard)" FontWeight="Bold" FontSize="13" Foreground="#991B1B" />
                <TextBlock Text="선택한 커밋 시점으로 HEAD 및 로컬 인덱스를 강제 복구합니다. 미커밋 변경 사항이 있으면 차단됩니다." FontSize="11" Foreground="#7F1D1D" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Commit & Path Details -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="대상 저장소:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtTargetPath" AutomationProperties.AutomationId="TxtRollbackTargetPath" TextTrimming="CharacterEllipsis" Foreground="#1E293B" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="되돌릴 커밋:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtCommitHash" AutomationProperties.AutomationId="TxtRollbackCommitHash" FontFamily="Consolas" FontWeight="Bold" Foreground="#1D4ED8" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bottom Buttons -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right"
                    x:Name="BtnConfirmRollback"
                    AutomationProperties.AutomationId="BtnConfirmRollback"
                    Content="되돌리기 실행"
                    Click="BtnConfirm_Click"
                    Padding="16,6"
                    Background="#DC2626"
                    Foreground="White"
                    BorderBrush="#B91C1C"
                    FontWeight="Bold"
                    Cursor="Hand" />

            <Button DockPanel.Dock="Right"
                    x:Name="BtnCancelRollback"
                    AutomationProperties.AutomationId="BtnCancelRollback"
                    Content="취소"
                    Click="BtnCancel_Click"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    Background="#F1F5F9"
                    BorderBrush="#CBD5E1" />
        </DockPanel>
    </Grid>
</Window>
