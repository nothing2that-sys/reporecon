<Window x:Class="RepoRecon.App.Views.UrlChangeSuggestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="URL 변경 감지 및 갱신 제안"
        Height="360" Width="600"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="DialogUrlChangeSuggestion"
        Background="{StaticResource NeutralSurface}"
        FontFamily="{StaticResource FontFamilyDefault}"
        Foreground="{StaticResource NeutralForeground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource InfoBackground}"
                BorderBrush="{StaticResource InfoBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="🔄 URL 변경 감지 — 새 주소로 갱신 제안 (§3.5, §10.7)" FontWeight="Bold" FontSize="{StaticResource FontSizeSubtitle}" Foreground="{StaticResource InfoForeground}" />
                <TextBlock Text="Orphaned 저장소의 네임스페이스 및 프로젝트가 다른 서버 카탈로그에서 발견되었습니다. 새 서버 주소로 Remote URL을 갱신하시겠습니까?" FontSize="{StaticResource FontSizeSecondary}" Foreground="{StaticResource InfoForeground}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Details showing both old and new URLs (Criterion 16) -->
        <Border Grid.Row="1"
                Background="{StaticResource NeutralBackground}"
                BorderBrush="{StaticResource NeutralBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="대상 저장소:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtTargetPath" AutomationProperties.AutomationId="TxtUrlChangeTargetPath" FontFamily="{StaticResource FontFamilyMono}" Foreground="{StaticResource NeutralForeground}" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="현재 이전 URL:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtOldUrl" AutomationProperties.AutomationId="TxtUrlChangeOldUrl" FontFamily="{StaticResource FontFamilyMono}" Foreground="{StaticResource ErrorForeground}" TextWrapping="Wrap" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="감지된 새 URL:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtNewUrl" AutomationProperties.AutomationId="TxtUrlChangeNewUrl" FontFamily="{StaticResource FontFamilyMono}" FontWeight="Bold" Foreground="{StaticResource SuccessForeground}" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bottom Buttons -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right"
                    x:Name="BtnConfirmUrlChange"
                    AutomationProperties.AutomationId="BtnConfirmUrlChange"
                    Content="새 주소로 갱신"
                    Click="BtnConfirm_Click"
                    IsDefault="True"
                    Padding="16,8"
                    Style="{StaticResource AccentButtonStyle}" />

            <Button DockPanel.Dock="Right"
                    x:Name="BtnCancelUrlChange"
                    AutomationProperties.AutomationId="BtnCancelUrlChange"
                    Content="취소"
                    Click="BtnCancel_Click"
                    IsCancel="True"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
