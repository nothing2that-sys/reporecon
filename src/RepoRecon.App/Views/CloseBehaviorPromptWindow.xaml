<Window x:Class="RepoRecon.App.Views.CloseBehaviorPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="창 닫기"
        Height="220" Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="DialogCloseBehaviorPrompt"
        Background="{StaticResource NeutralSurface}"
        FontFamily="{StaticResource FontFamilyDefault}"
        Foreground="{StaticResource NeutralForeground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="창을 닫으면 앱을 종료할까요, 트레이로 최소화할까요?"
                       FontWeight="SemiBold"
                       FontSize="{StaticResource FontSizeSubtitle}"
                       TextWrapping="Wrap" />
            <TextBlock Text="이 선택은 저장되며, 다음부터는 다시 묻지 않습니다. 나중에 하단 상태 바의 설정에서 바꿀 수 있습니다."
                       Foreground="{StaticResource NeutralForegroundMuted}"
                       FontSize="{StaticResource FontSizeSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
        </StackPanel>

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right"
                    x:Name="BtnExit"
                    AutomationProperties.AutomationId="BtnCloseBehaviorExit"
                    Content="종료"
                    Click="BtnExit_Click"
                    IsDefault="True"
                    Padding="16,8"
                    Style="{StaticResource AccentButtonStyle}" />

            <Button DockPanel.Dock="Right"
                    x:Name="BtnMinimizeToTray"
                    AutomationProperties.AutomationId="BtnCloseBehaviorTray"
                    Content="트레이로 최소화"
                    Click="BtnMinimizeToTray_Click"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
