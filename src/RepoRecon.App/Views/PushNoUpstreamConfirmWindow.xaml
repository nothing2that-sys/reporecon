<Window x:Class="RepoRecon.App.Views.PushNoUpstreamConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="개별 Push (원격 브랜치 생성) 확인"
        Height="310" Width="540"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="DialogPushNoUpstreamConfirm"
        Background="#F8FAFC">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Notice Header -->
        <Border Grid.Row="0"
                Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="🚀 원격 추적 브랜치 생성 및 푸시 (git push -u)" FontWeight="Bold" FontSize="13" Foreground="#1E40AF" />
                <TextBlock Text="로컬 체크아웃 브랜치를 원격 서버(origin)에 새 브랜치로 생성하고 업스트림을 연결합니다." FontSize="11" Foreground="#1E3A8A" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Details -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="대상 저장소:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtTargetPath" AutomationProperties.AutomationId="TxtPushNoUpstreamTargetPath" TextTrimming="CharacterEllipsis" Foreground="#1E293B" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="서버에 생성될 브랜치:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtRemoteBranch" AutomationProperties.AutomationId="TxtPushNoUpstreamBranch" FontWeight="Bold" Foreground="#16A34A" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bottom Buttons -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right"
                    x:Name="BtnConfirmPushNoUpstream"
                    AutomationProperties.AutomationId="BtnConfirmPushNoUpstream"
                    Content="Push 및 업스트림 설정"
                    Click="BtnConfirm_Click"
                    Padding="16,6"
                    Background="#2563EB"
                    Foreground="White"
                    BorderBrush="#1D4ED8"
                    FontWeight="Bold"
                    Cursor="Hand" />

            <Button DockPanel.Dock="Right"
                    x:Name="BtnCancelPushNoUpstream"
                    AutomationProperties.AutomationId="BtnCancelPushNoUpstream"
                    Content="취소"
                    Click="BtnCancel_Click"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    Background="#F1F5F9"
                    BorderBrush="#CBD5E1" />
        </DockPanel>
    </Grid>
</Window>
