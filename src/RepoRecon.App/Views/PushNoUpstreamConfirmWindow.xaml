<Window x:Class="RepoRecon.App.Views.PushNoUpstreamConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="개별 Push (원격 브랜치 생성) 확인"
        Height="310" Width="540"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="DialogPushNoUpstreamConfirm"
        Background="{StaticResource NeutralSurface}"
        FontFamily="{StaticResource FontFamilyDefault}"
        Foreground="{StaticResource NeutralForeground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Notice Header -->
        <Border Grid.Row="0"
                Background="{StaticResource InfoBackground}"
                BorderBrush="{StaticResource InfoBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="🚀 원격 추적 브랜치 생성 및 푸시 (git push -u)" FontWeight="Bold" FontSize="{StaticResource FontSizeSubtitle}" Foreground="{StaticResource InfoForeground}" />
                <TextBlock Text="로컬 체크아웃 브랜치를 원격 서버(origin)에 새 브랜치로 생성하고 업스트림을 연결합니다." FontSize="{StaticResource FontSizeSecondary}" Foreground="{StaticResource InfoForeground}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Details -->
        <Border Grid.Row="1"
                Background="{StaticResource NeutralBackground}"
                BorderBrush="{StaticResource NeutralBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="대상 저장소:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtTargetPath" AutomationProperties.AutomationId="TxtPushNoUpstreamTargetPath" FontFamily="{StaticResource FontFamilyMono}" Foreground="{StaticResource NeutralForeground}" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="서버에 생성될 브랜치:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtRemoteBranch" AutomationProperties.AutomationId="TxtPushNoUpstreamBranch" FontFamily="{StaticResource FontFamilyMono}" FontWeight="Bold" Foreground="{StaticResource SuccessForeground}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bottom Buttons -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right"
                    x:Name="BtnConfirmPushNoUpstream"
                    AutomationProperties.AutomationId="BtnConfirmPushNoUpstream"
                    Content="Push 및 업스트림 설정"
                    Click="BtnConfirm_Click"
                    IsDefault="True"
                    Padding="16,8"
                    Style="{StaticResource AccentButtonStyle}" />

            <Button DockPanel.Dock="Right"
                    x:Name="BtnCancelPushNoUpstream"
                    AutomationProperties.AutomationId="BtnCancelPushNoUpstream"
                    Content="취소"
                    Click="BtnCancel_Click"
                    IsCancel="True"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
