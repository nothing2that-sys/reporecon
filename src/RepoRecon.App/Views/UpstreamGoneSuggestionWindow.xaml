<Window x:Class="RepoRecon.App.Views.UpstreamGoneSuggestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Upstream Gone 대응 제안"
        Height="310" Width="540"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="DialogUpstreamGoneSuggestion"
        Background="{StaticResource NeutralSurface}"
        FontFamily="{StaticResource FontFamilyDefault}"
        Foreground="{StaticResource NeutralForeground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource WarningBackground}"
                BorderBrush="{StaticResource WarningBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="⚠️ Upstream Gone 감지 — 기본 브랜치로 전환 제안 (§3.4)" FontWeight="Bold" FontSize="{StaticResource FontSizeSubtitle}" Foreground="{StaticResource WarningForeground}" />
                <TextBlock Text="기존 원격 추적 브랜치가 서버에서 삭제되었습니다. 서버 카탈로그의 기본 브랜치로 업스트림을 재설정할 수 있습니다." FontSize="{StaticResource FontSizeSecondary}" Foreground="{StaticResource WarningForeground}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Details -->
        <Border Grid.Row="1"
                Background="{StaticResource NeutralBackground}"
                BorderBrush="{StaticResource NeutralBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="대상 저장소:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtTargetPath" AutomationProperties.AutomationId="TxtUpstreamGoneTargetPath" FontFamily="{StaticResource FontFamilyMono}" Foreground="{StaticResource NeutralForeground}" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="새 업스트림 제안:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtSuggestedUpstream" AutomationProperties.AutomationId="TxtUpstreamGoneBranch" FontFamily="{StaticResource FontFamilyMono}" FontWeight="Bold" Foreground="{StaticResource SuccessForeground}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bottom Buttons -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right"
                    x:Name="BtnConfirmUpstreamGone"
                    AutomationProperties.AutomationId="BtnConfirmUpstreamGone"
                    Content="업스트림 전환 적용"
                    Click="BtnConfirm_Click"
                    IsDefault="True"
                    Padding="16,8"
                    Style="{StaticResource AccentButtonStyle}" />

            <Button DockPanel.Dock="Right"
                    x:Name="BtnCancelUpstreamGone"
                    AutomationProperties.AutomationId="BtnCancelUpstreamGone"
                    Content="취소"
                    Click="BtnCancel_Click"
                    IsCancel="True"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
