<Window x:Class="RepoRecon.App.Views.ClonePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RepoRecon.App.ViewModels"
        mc:Ignorable="d"
        Title="클론 미리보기"
        Height="550" Width="850"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="DialogClonePreview"
        Background="{StaticResource NeutralSurface}"
        FontFamily="{StaticResource FontFamilyDefault}"
        Foreground="{StaticResource NeutralForeground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Summary Header -->
        <Border Grid.Row="0"
                Background="{StaticResource InfoBackground}"
                BorderBrush="{StaticResource InfoBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="🚀 클론 실행 미리보기" FontWeight="Bold" FontSize="{StaticResource FontSizeSubtitle}" Foreground="{StaticResource InfoForeground}" />
                <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource InfoForeground}" Margin="0,4,0,0" AutomationProperties.AutomationId="TxtCloneSummary" />
                <TextBlock Text="{Binding TargetRoot, StringFormat='대상 기본 루트: {0}'}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{StaticResource NeutralForegroundMuted}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Preview Grid -->
        <Border Grid.Row="1"
                Background="{StaticResource NeutralBackground}"
                BorderBrush="{StaticResource NeutralBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="4">
            <DataGrid ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource NeutralSurface}"
                      RowHeaderWidth="0"
                      BorderThickness="0"
                      AutomationProperties.AutomationId="GridClonePreview">
                <DataGrid.Columns>
                    <!-- Status / Action Column -->
                    <DataGridTemplateColumn Header="상태" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource SuccessBackground}" CornerRadius="3" Padding="8,4"
                                            Visibility="{Binding HasCollision, Converter={StaticResource InvertedBoolToVis}}">
                                        <TextBlock Text="실행 가능" FontSize="{StaticResource FontSizeSecondary}" FontWeight="Bold" Foreground="{StaticResource SuccessForeground}" />
                                    </Border>
                                    <Border Background="{StaticResource ErrorBackground}" CornerRadius="3" Padding="8,4"
                                            Visibility="{Binding HasCollision, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="충돌 스킵" FontSize="{StaticResource FontSizeSecondary}" FontWeight="Bold" Foreground="{StaticResource ErrorForeground}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Repo Info -->
                    <DataGridTextColumn Header="네임스페이스 / 저장소"
                                        Binding="{Binding Repo.NormalizedKey}"
                                        Width="220"
                                        FontWeight="SemiBold" />

                    <!-- Target Path -->
                    <DataGridTemplateColumn Header="생성 대상 경로" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TargetPath, Converter={StaticResource FrontEllipsis}, ConverterParameter=56}"
                                               ToolTip="{Binding TargetPath}"
                                               FontFamily="{StaticResource FontFamilyMono}"
                                               FontSize="{StaticResource FontSizeSecondary}" Foreground="{StaticResource NeutralForeground}" />
                                    <TextBlock Text="{Binding CollisionReason}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{StaticResource ErrorForeground}"
                                               Visibility="{Binding HasCollision, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="⚠️ 260자 초과 (Long Path 적용)"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{StaticResource WarningForeground}"
                                               Visibility="{Binding ExceedsLongPath, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Bottom Action Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="취소"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"
                    AutomationProperties.AutomationId="BtnCancelClone"
                    Click="BtnCancel_Click" />
            <Button Content="클론 실행"
                    Padding="16,8"
                    Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True"
                    AutomationProperties.AutomationId="BtnConfirmClone"
                    Click="BtnConfirm_Click" />
        </StackPanel>
    </Grid>
</Window>
