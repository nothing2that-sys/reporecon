<Window x:Class="RepoRecon.App.Views.ProfileManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RepoRecon.App.ViewModels"
        mc:Ignorable="d"
        Title="서버 프로파일 관리"
        Height="550" Width="750"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="DialogProfileManagement"
        Background="#F8FAFC">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Notice Banner -->
        <Border Grid.Row="0"
                Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="🔒 보안 및 포터블 모드 안내 (설계 §9.3)"
                           FontWeight="Bold"
                           Foreground="#1E40AF" />
                <TextBlock x:Name="TxtDpapiSecurityNotice"
                           AutomationProperties.AutomationId="TxtDpapiSecurityNotice"
                           Text="API 토큰은 Windows DPAPI(CurrentUser)로 암호화되어 로컬 계정 범위로만 안전하게 보관됩니다. DB/설정/로그/URL 어디에도 평문으로 저장되지 않습니다."
                           FontSize="12"
                           Foreground="#1E40AF"
                           Margin="0,3,0,0" />
                <TextBlock x:Name="TxtDpapiPortableNotice"
                           AutomationProperties.AutomationId="TxtDpapiPortableNotice"
                           Text="※ 포터블 모드 제약: 토큰 파일(credentials/*.dat)이 exe 옆에 위치하더라도 현재 Windows 사용자 계정으로 암호화되므로, 다른 PC로 이동 시 복호화되지 않아 토큰을 다시 입력해야 합니다."
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#B45309"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Main Content Area: Left Profile List, Right Edit Form -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Profile List -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Bottom"
                            Content="+ 새 프로파일"
                            Margin="0,8,0,0"
                            Padding="8,6"
                            FontWeight="SemiBold"
                            Background="#F1F5F9"
                            BorderBrush="#CBD5E1"
                            AutomationProperties.AutomationId="BtnNewProfile"
                            Command="{Binding ResetFormCommand}" />

                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             BorderThickness="0"
                             AutomationProperties.AutomationId="ListServerProfiles"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,4" Margin="0,2">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{Binding Host}" FontWeight="Bold" Foreground="#0F172A" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Background="#E0E7FF" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding ApiKind}" FontSize="10" FontWeight="SemiBold" Foreground="#3730A3" />
                                            </Border>
                                            <TextBlock Text="{Binding ApiVersion, StringFormat='({0})'}" FontSize="10" Foreground="#64748B" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right: Edit Form -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="프로파일 설정" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12" />

                        <!-- Host -->
                        <TextBlock Text="호스트 주소 (예: github.com, gitlab.mycorp.test)" FontWeight="SemiBold" FontSize="12" Foreground="#334155" />
                        <TextBox Text="{Binding EditHost, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,10" Padding="6,4"
                                 AutomationProperties.AutomationId="TxtProfileHost" />

                        <!-- API Kind -->
                        <TextBlock Text="서버 API 종류" FontWeight="SemiBold" FontSize="12" Foreground="#334155" />
                        <ComboBox ItemsSource="{Binding AvailableApiKinds}"
                                  SelectedItem="{Binding EditApiKind}"
                                  Margin="0,4,0,10" Padding="6,4"
                                  AutomationProperties.AutomationId="CmbProfileApiKind" />

                        <!-- Aliases -->
                        <TextBlock Text="호스트 별칭 목록 (쉼표 구분, 예: 192.0.2.11, gitlab.internal)" FontWeight="SemiBold" FontSize="12" Foreground="#334155" />
                        <TextBox Text="{Binding EditAliases, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,10" Padding="6,4"
                                 AutomationProperties.AutomationId="TxtProfileAliases" />

                        <!-- Token -->
                        <TextBlock Text="API 액세스 토큰" FontWeight="SemiBold" FontSize="12" Foreground="#334155" />
                        <PasswordBox x:Name="PbToken"
                                     PasswordChanged="PbToken_PasswordChanged"
                                     Margin="0,4,0,4" Padding="6,4"
                                     AutomationProperties.AutomationId="PbProfileToken" />
                        <TextBlock Text="{Binding TokenStatusText}"
                                   FontSize="11" Foreground="#64748B" Margin="0,0,0,12"
                                   AutomationProperties.AutomationId="TxtTokenStatus" />

                        <!-- Test Connection Button & Result -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="연결 테스트"
                                    Padding="10,5"
                                    FontWeight="SemiBold"
                                    Background="#F1F5F9"
                                    BorderBrush="#CBD5E1"
                                    AutomationProperties.AutomationId="BtnTestConnection"
                                    Command="{Binding TestConnectionCommand}" />
                            <TextBlock Text="{Binding TestResultMessage}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       AutomationProperties.AutomationId="TxtTestResult" />
                        </StackPanel>

                        <!-- Action Buttons: Save & Delete -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="닫기"
                                    Margin="0,0,8,0"
                                    Padding="12,6"
                                    Background="#F1F5F9"
                                    BorderBrush="#CBD5E1"
                                    FontWeight="SemiBold"
                                    AutomationProperties.AutomationId="BtnCloseProfileManagement"
                                    Click="BtnClose_Click" />
                            <Button Content="삭제"
                                    Margin="0,0,8,0"
                                    Padding="12,6"
                                    Background="#FEE2E2"
                                    BorderBrush="#FCA5A5"
                                    Foreground="#991B1B"
                                    FontWeight="SemiBold"
                                    AutomationProperties.AutomationId="BtnDeleteProfile"
                                    Command="{Binding DeleteProfileCommand}" />
                            <Button Content="저장"
                                    Padding="16,6"
                                    Background="#2563EB"
                                    BorderBrush="#1D4ED8"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    AutomationProperties.AutomationId="BtnSaveProfile"
                                    Command="{Binding SaveProfileCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Message Footer -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   FontSize="12"
                   Foreground="#475569"
                   Margin="0,8,0,0"
                   AutomationProperties.AutomationId="TxtProfileStatus" />
    </Grid>
</Window>
