<Window x:Class="RepoRecon.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RepoRecon.App.ViewModels"
        xmlns:tree="clr-namespace:RepoRecon.App.ViewModels.Tree"
        mc:Ignorable="d"
        Title="RepoRecon (Phase 5)"
        Height="850" Width="1280"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/reporecon.ico"
        Background="{StaticResource NeutralSurface}"
        FontFamily="{StaticResource FontFamilyDefault}"
        Foreground="{StaticResource NeutralForeground}">

    <!-- §10.4 키보드 단축키는 전부 code-behind MainWindow_KeyDown 한 곳에만 둔다.
         여기 Window.InputBindings에도 F5/Ctrl+A를 중복 선언했던 것이 작업 4 감사에서
         발견된 이중 배선 결함이다 — 한쪽만 고치면 동작이 갈린다. -->

    <Window.Resources>
        <!-- Style for TreeViewItem to support custom selection & expansion -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding FullPath}" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource InfoBackground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Notice Banners -->
            <RowDefinition Height="*" />    <!-- Main Tabs (Local Management & Clone) -->
            <RowDefinition Height="Auto" /> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- Notification Banners -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <!-- Git Diagnostic Alert Banner -->
            <Border Background="{StaticResource ErrorBackground}"
                    BorderBrush="{StaticResource ErrorBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,8"
                    Visibility="{Binding HasGitDiagnosticError, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="⚠️ Git 환경 오류 — 기능이 제한됩니다"
                               FontWeight="Bold"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               Foreground="{StaticResource ErrorForeground}" />
                    <TextBlock Text="{Binding GitDiagnosticError}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource ErrorForeground}" />
                </StackPanel>
            </Border>

            <!-- DB Recreated Notice -->
            <Border Background="{StaticResource WarningBackground}"
                    BorderBrush="{StaticResource WarningBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,0,8"
                    Visibility="{Binding WasDatabaseRecreated, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding DatabaseRecreatedNotice}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource WarningForeground}" />
            </Border>

            <!-- Residual Temp Folders Notice (§7.3, §10 Criterion 21) -->
            <Border x:Name="PanelResidualTempFolders"
                    AutomationProperties.AutomationId="PanelResidualTempFolders"
                    Background="{StaticResource ErrorBackground}"
                    BorderBrush="{StaticResource ErrorBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,0,8"
                    Visibility="{Binding HasResidualTempFolders, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            x:Name="BtnCleanResidualTempFolders"
                            AutomationProperties.AutomationId="BtnCleanResidualTempFolders"
                            Content="지금 정리하기"
                            Command="{Binding CleanResidualTempFoldersCommand}"
                            Padding="8,4"
                            Margin="12,0,0,0"
                            Style="{StaticResource DangerButtonStyle}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ResidualTempFoldersNotice}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ErrorForeground}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Authentication host cooldown notice (design v3 §8.4) -->
            <Border x:Name="PanelAuthCooldown"
                    AutomationProperties.AutomationId="PanelAuthCooldown"
                    Background="{StaticResource WarningBackground}"
                    BorderBrush="{StaticResource WarningBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,0,8"
                    Visibility="{Binding HasAuthenticationCooldowns, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            x:Name="BtnRetryAuthCooldown"
                            AutomationProperties.AutomationId="BtnRetryAuthCooldown"
                            Content="지금 재시도"
                            Command="{Binding RefreshAllCommand}"
                            Padding="8,4"
                            Margin="12,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            VerticalAlignment="Center"
                            ToolTip="인증 쿨오프를 즉시 해제하고 다시 스캔·Fetch합니다." />
                    <StackPanel>
                        <TextBlock Text="인증 실패 호스트 재시도 대기"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WarningForeground}" />
                        <TextBlock x:Name="TxtAuthCooldownSummary"
                                   AutomationProperties.AutomationId="TxtAuthCooldownSummary"
                                   Text="{Binding AuthenticationCooldownSummary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource WarningForeground}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Background="Transparent"
                    BorderThickness="0">

            <!-- TAB 1: 로컬 관리 -->
            <TabItem Header="📁 로컬 관리"
                     FontSize="{StaticResource FontSizeSubtitle}"
                     FontWeight="SemiBold"
                     Padding="16,8"
                     AutomationProperties.AutomationId="TabLocalManagement">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Scan Roots Control Panel (0) -->
                        <RowDefinition Height="Auto" /> <!-- Toolbar / Filters / Execution Bar (1) -->
                        <RowDefinition Height="Auto" /> <!-- Pull Skip Reasons Panel (2) -->
                        <RowDefinition Height="Auto" /> <!-- Push Skip Reasons Panel (3) -->
                        <RowDefinition Height="Auto" /> <!-- Inaccessible Paths Panel (4) -->
                        <RowDefinition Height="*" />    <!-- Main Hierarchical Tree View / Empty State (5) -->
                        <RowDefinition Height="Auto" /> <!-- Pull Execution Panel (6) -->
                        <RowDefinition Height="Auto" /> <!-- Push Execution Panel (7) -->
                        <RowDefinition Height="Auto" /> <!-- Job History Panel (8) -->
                        <RowDefinition Height="Auto" /> <!-- Selection Basket Panel (9) -->
                        <RowDefinition Height="Auto" /> <!-- Legend Panel (10) -->
                    </Grid.RowDefinitions>

                    <!-- Scan Roots Management Panel -->
                    <Border Grid.Row="0"
                            Background="{StaticResource NeutralBackground}"
                            BorderBrush="{StaticResource NeutralBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Add Row -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="스캔 경로:"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0" />

                                <TextBox Grid.Column="1"
                                         x:Name="TxtScanPath"
                                         AutomationProperties.AutomationId="TxtScanPath"
                                         Text="{Binding NewScanRootPath, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"
                                         Padding="8,4"
                                         Margin="0,0,8,0"
                                         TabIndex="0"
                                         ToolTip="폴더 선택 대화상자나 이 아래 트리 뷰로의 드래그앤드롭이 우선 수단입니다. 직접 입력은 보조 수단입니다(§6)." />

                                <!-- Folder Picker (§6, OpenFolderDialog, 진입점 1/2) -->
                                <Button Grid.Column="2"
                                        x:Name="BtnBrowseFolder"
                                        AutomationProperties.AutomationId="BtnBrowseFolder"
                                        Content="찾아보기..."
                                        Click="BrowseFolder_Click"
                                        Padding="12,4"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        TabIndex="1"
                                        ToolTip="폴더 선택 대화상자로 스캔 루트 경로를 고릅니다." />

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,8,0">
                                    <TextBlock Text="깊이:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Text="{Binding NewScanRootDepth, UpdateSourceTrigger=PropertyChanged}"
                                             Width="40"
                                             VerticalContentAlignment="Center"
                                             Padding="4,4"
                                             TabIndex="2" />
                                </StackPanel>

                                <Button Grid.Column="4"
                                        x:Name="BtnAddScanRoot"
                                        AutomationProperties.AutomationId="BtnAddScanRoot"
                                        Content="루트 추가"
                                        Command="{Binding AddScanRootCommand}"
                                        Padding="12,4"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        TabIndex="3" />

                                <Button Grid.Column="5"
                                        x:Name="BtnStartScan"
                                        AutomationProperties.AutomationId="BtnStartScan"
                                        Content="스캔 시작"
                                        Command="{Binding StartScanCommand}"
                                        IsEnabled="{Binding IsNotScanning}"
                                        FontWeight="Bold"
                                        Padding="16,4"
                                        Style="{StaticResource AccentButtonStyle}"
                                        TabIndex="4"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="스캔이 이미 진행 중일 때는 비활성화됩니다." />
                            </Grid>

                            <!-- Active Roots List -->
                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{Binding ScanRoots}"
                                          Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource NeutralSurface}"
                                                BorderBrush="{StaticResource NeutralBorder}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                Margin="0,0,8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding Path}"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                           ToolTip="{Binding Path, Converter={StaticResource FrontEllipsis}, ConverterParameter=80}" />
                                                <TextBlock Text="{Binding MaxDepth, StringFormat=' (깊이:{0})'}"
                                                           FontSize="{StaticResource FontSizeSecondary}"
                                                           Foreground="{StaticResource NeutralForegroundMuted}"
                                                           VerticalAlignment="Center" />
                                                <Button Content="✕"
                                                        Command="{Binding DataContext.RemoveScanRootCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="8,0,0,0"
                                                        Padding="4,0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{StaticResource NeutralForegroundMuted}"
                                                        Cursor="Hand"
                                                        ToolTip="이 스캔 루트 제거" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Filter Toolbar & Selection / Execution Bar -->
                    <Border Grid.Row="1"
                            Background="{StaticResource NeutralBackground}"
                            BorderBrush="{StaticResource NeutralBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <!-- Right Execution Summary & Pull / Push Execution Buttons -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtExecutionSummary"
                                           AutomationProperties.AutomationId="TxtExecutionSummary"
                                           Text="{Binding ExecutionSummaryText}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />

                                <Button x:Name="BtnExecutePull"
                                        AutomationProperties.AutomationId="BtnExecutePull"
                                        Content="일괄 Pull 실행"
                                        Command="{Binding ExecutePullCommand}"
                                        IsEnabled="{Binding CanExecutePull}"
                                        Padding="12,8"
                                        Margin="0,0,12,0"
                                        Background="{StaticResource SuccessForeground}"
                                        Foreground="{StaticResource AccentForeground}"
                                        BorderBrush="{StaticResource SuccessForeground}"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        TabIndex="13"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Pull 가능한 저장소가 없으면 비활성화됩니다(선택 대상이 Behind 상태여야 합니다)." />

                                <TextBlock x:Name="TxtPushSelectionSummary"
                                           AutomationProperties.AutomationId="TxtPushSelectionSummary"
                                           Text="{Binding PushExecutionSummaryText}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="4,0,8,0" />

                                <Button x:Name="BtnExecutePush"
                                        AutomationProperties.AutomationId="BtnExecutePush"
                                        Content="🚀 일괄 Push 실행"
                                        Command="{Binding ExecutePushCommand}"
                                        IsEnabled="{Binding CanExecutePush}"
                                        Padding="12,8"
                                        Style="{StaticResource AccentButtonStyle}"
                                        TabIndex="14"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Push 가능한 저장소가 없으면 비활성화됩니다(선택 대상이 Ahead이고 Diverged가 아니어야 합니다)." />
                            </StackPanel>

                            <!-- Left: Filter Controls & Fast Actions -->
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="TxtFilter"
                                         AutomationProperties.AutomationId="TxtFilter"
                                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         Width="140"
                                         Padding="4,4"
                                         Margin="0,0,8,0"
                                         TabIndex="0"
                                         ToolTip="폴더명, 브랜치명, 원격 URL 검색" />

                                <!-- [동기화] 배타 그룹 (§5.3.3) -->
                                <Border BorderBrush="{StaticResource NeutralBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="동기화" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource NeutralForegroundMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <RadioButton GroupName="SyncFilter" Content="전체"
                                                     x:Name="BtnFilterSyncAll"
                                                     AutomationProperties.AutomationId="BtnFilterSyncAll"
                                                     IsChecked="{Binding FilterSyncAll, Mode=TwoWay}"
                                                     Style="{StaticResource FilterRadioButtonStyle}"
                                                     TabIndex="1" />
                                        <RadioButton GroupName="SyncFilter" Content="받을 것 있음"
                                                     x:Name="BtnFilterBehind"
                                                     AutomationProperties.AutomationId="BtnFilterBehind"
                                                     IsChecked="{Binding FilterBehindOnly, Mode=TwoWay}"
                                                     Style="{StaticResource FilterRadioButtonStyle}"
                                                     TabIndex="2" />
                                        <RadioButton GroupName="SyncFilter" Content="올릴 것 있음"
                                                     IsChecked="{Binding FilterAheadOnly, Mode=TwoWay}"
                                                     Style="{StaticResource FilterRadioButtonStyle}"
                                                     TabIndex="3" />
                                        <RadioButton GroupName="SyncFilter" Content="갈라짐"
                                                     x:Name="BtnFilterDiverged"
                                                     AutomationProperties.AutomationId="BtnFilterDiverged"
                                                     IsChecked="{Binding FilterDivergedOnly, Mode=TwoWay}"
                                                     Style="{StaticResource FilterRadioButtonStyle}"
                                                     TabIndex="4" />
                                        <RadioButton GroupName="SyncFilter" Content="추적 브랜치 없음"
                                                     IsChecked="{Binding FilterNoUpstreamOnly, Mode=TwoWay}"
                                                     Style="{StaticResource FilterRadioButtonStyle}"
                                                     TabIndex="5" />
                                        <RadioButton GroupName="SyncFilter" Content="사라진 브랜치"
                                                     IsChecked="{Binding FilterUpstreamGoneOnly, Mode=TwoWay}"
                                                     Style="{StaticResource FilterRadioButtonStyle}"
                                                     TabIndex="6" />
                                        <RadioButton GroupName="SyncFilter" Content="미체크아웃"
                                                     IsChecked="{Binding FilterDetachedHeadOnly, Mode=TwoWay}"
                                                     Style="{StaticResource FilterRadioButtonStyle}"
                                                     TabIndex="7" />
                                    </StackPanel>
                                </Border>

                                <!-- [작업트리] 독립 토글 그룹 (§5.3.3) -->
                                <Border BorderBrush="{StaticResource NeutralBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="작업트리" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource NeutralForegroundMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ToggleButton Content="미커밋 변경"
                                                      x:Name="BtnFilterDirty"
                                                      AutomationProperties.AutomationId="BtnFilterDirty"
                                                      IsChecked="{Binding FilterDirtyOnly, Mode=TwoWay}"
                                                      Style="{StaticResource FilterToggleButtonStyle}"
                                                      TabIndex="8" />
                                        <ToggleButton Content="머지 충돌"
                                                      IsChecked="{Binding FilterConflictedOnly, Mode=TwoWay}"
                                                      Style="{StaticResource FilterToggleButtonStyle}"
                                                      TabIndex="9" />
                                    </StackPanel>
                                </Border>

                                <!-- [기타] 독립 토글 그룹 (§5.3.3) -->
                                <Border BorderBrush="{StaticResource NeutralBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="기타" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource NeutralForegroundMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ToggleButton Content="보관됨"
                                                      IsChecked="{Binding FilterArchivedOnly, Mode=TwoWay}"
                                                      Style="{StaticResource FilterToggleButtonStyle}"
                                                      TabIndex="10" />
                                        <ToggleButton Content="확인 안 됨"
                                                      IsChecked="{Binding FilterMissingOnly, Mode=TwoWay}"
                                                      Style="{StaticResource FilterToggleButtonStyle}"
                                                      TabIndex="11" />
                                        <ComboBox ItemsSource="{Binding AvailableHosts}"
                                                  SelectedItem="{Binding SelectedHostFilter, Mode=TwoWay}"
                                                  Margin="4,0,0,0"
                                                  Padding="8,4"
                                                  FontSize="{StaticResource FontSizeBody}"
                                                  Width="110"
                                                  TabIndex="12"
                                                  AutomationProperties.AutomationId="CmbHostFilter" />
                                        <ComboBox ItemsSource="{Binding AvailablePathPrefixes}"
                                                  SelectedItem="{Binding SelectedPathPrefixFilter, Mode=TwoWay}"
                                                  Margin="4,0,0,0"
                                                  Padding="8,4"
                                                  FontSize="{StaticResource FontSizeBody}"
                                                  Width="130"
                                                  TabIndex="13"
                                                  AutomationProperties.AutomationId="CmbPathPrefixFilter"
                                                  ToolTip="스캔 루트 경로 접두사로 필터링합니다." />
                                    </StackPanel>
                                </Border>

                                <Button Content="전체 선택"
                                        x:Name="BtnSelectAllVisible"
                                        AutomationProperties.AutomationId="BtnSelectAllVisible"
                                        Command="{Binding SelectAllVisibleCommand}"
                                        Padding="8,4"
                                        Margin="4,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        TabIndex="14" />

                                <Button Content="선택 해제"
                                        AutomationProperties.AutomationId="BtnDeselectAll"
                                        Command="{Binding DeselectAllCommand}"
                                        Padding="8,4"
                                        Margin="4,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        TabIndex="15" />

                                <Button Content="새로고침 (F5)"
                                        x:Name="BtnRefreshAll"
                                        AutomationProperties.AutomationId="BtnRefreshAll"
                                        Command="{Binding RefreshAllCommand}"
                                        Padding="8,4"
                                        Margin="4,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        TabIndex="16" />

                                <Separator Margin="4,4" />

                                <Button Content="호스트 일괄 치환..."
                                        x:Name="BtnOpenBulkHostReplace"
                                        AutomationProperties.AutomationId="BtnOpenBulkHostReplace"
                                        Command="{Binding OpenBulkHostReplaceCommand}"
                                        Padding="8,4"
                                        Margin="4,0"
                                        Background="{StaticResource NeutralSurface}"
                                        BorderBrush="{StaticResource NeutralBorder}"
                                        FontWeight="SemiBold"
                                        TabIndex="17"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="대상 저장소의 Remote URL을 불러오는 동안 일시적으로 비활성화됩니다." />

                                <Button Content="상태 내보내기"
                                        x:Name="BtnExportState"
                                        AutomationProperties.AutomationId="BtnExportState"
                                        Command="{Binding ExportStateCommand}"
                                        Padding="8,4"
                                        Margin="4,0"
                                        Background="{StaticResource NeutralSurface}"
                                        BorderBrush="{StaticResource NeutralBorder}"
                                        FontWeight="SemiBold"
                                        TabIndex="18" />

                                <Button Content="📋 작업 이력"
                                        x:Name="BtnToggleJobHistory"
                                        AutomationProperties.AutomationId="BtnToggleJobHistory"
                                        Command="{Binding ToggleHistoryPanelCommand}"
                                        Padding="8,4"
                                        Margin="4,0"
                                        Background="{StaticResource InfoBackground}"
                                        BorderBrush="{StaticResource InfoBorder}"
                                        Foreground="{StaticResource InfoForeground}"
                                        FontWeight="Bold"
                                        TabIndex="19" />

                                <!-- Selection Basket toggle (§5.3.4) -->
                                <Button x:Name="BtnToggleSelectionBasket"
                                        AutomationProperties.AutomationId="BtnToggleSelectionBasket"
                                        Content="{Binding TotalSelectedCount, StringFormat='🧺 선택 {0}'}"
                                        Command="{Binding ToggleSelectionBasketCommand}"
                                        Padding="8,4"
                                        Margin="4,0"
                                        Background="{StaticResource InfoBackground}"
                                        BorderBrush="{StaticResource InfoBorder}"
                                        Foreground="{StaticResource InfoForeground}"
                                        FontWeight="Bold"
                                        TabIndex="20"
                                        ToolTip="좌측 노드를 옮기거나 필터를 바꿔도 여기 담긴 선택은 유지됩니다(§5.3.4)." />

                                <!-- Legend toggle (§5.5) -->
                                <Button Content="❓ 범례"
                                        x:Name="BtnToggleLegend"
                                        AutomationProperties.AutomationId="BtnToggleLegend"
                                        Command="{Binding ToggleLegendCommand}"
                                        Padding="8,4"
                                        Margin="4,0"
                                        Background="{StaticResource InfoBackground}"
                                        BorderBrush="{StaticResource InfoBorder}"
                                        Foreground="{StaticResource InfoForeground}"
                                        FontWeight="Bold"
                                        TabIndex="21" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <!-- Pull Skip Reasons Notice Panel -->
                    <Border Grid.Row="2"
                            Background="{StaticResource WarningBackground}"
                            BorderBrush="{StaticResource WarningBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,4"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasSkipReasons, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Vertical">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        AutomationProperties.AutomationId="BtnToggleSkipReasons"
                                        Content="{Binding IsSkipDetailsExpanded, Converter={StaticResource BoolToLabel}, ConverterParameter='접기|상세보기'}"
                                        Command="{Binding ToggleSkipDetailsCommand}"
                                        Padding="8,4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource WarningForeground}"
                                        FontWeight="Bold"
                                        Cursor="Hand" />
                                <TextBlock Text="{Binding SkipReasonSummary, StringFormat='ℹ️ Pull 스킵 안내: {0}'}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningForeground}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <!-- 사유별 개별 내역 (건수 요약이 아니라 항목별 행) -->
                            <ItemsControl AutomationProperties.AutomationId="ListSkipReasons"
                                          ItemsSource="{Binding SkipReasonList}"
                                          Margin="0,4,0,0"
                                          Visibility="{Binding IsSkipDetailsExpanded, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="{StaticResource FontSizeSecondary}"
                                                   Foreground="{StaticResource WarningForeground}"
                                                   Margin="12,1,0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Push Skip Reasons Notice Panel (§7.5, §7.6) -->
                    <Border Grid.Row="3"
                            Background="{StaticResource InfoBackground}"
                            BorderBrush="{StaticResource InfoBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,4"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasPushSkipReasons, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Vertical">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        AutomationProperties.AutomationId="BtnTogglePushSkipReasons"
                                        Content="{Binding IsPushSkipDetailsExpanded, Converter={StaticResource BoolToLabel}, ConverterParameter='접기|상세보기'}"
                                        Command="{Binding TogglePushSkipDetailsCommand}"
                                        Padding="8,4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource InfoForeground}"
                                        FontWeight="Bold"
                                        Cursor="Hand" />
                                <TextBlock x:Name="TxtPushSkipBreakdown"
                                           AutomationProperties.AutomationId="TxtPushSkipBreakdown"
                                           Text="{Binding PushSkipReasonSummary, StringFormat='ℹ️ Push 스킵 안내: {0}'}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InfoForeground}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <!-- 사유별 개별 내역 (건수 요약이 아니라 항목별 행) -->
                            <ItemsControl AutomationProperties.AutomationId="ListPushSkipReasons"
                                          ItemsSource="{Binding PushSkipReasonList}"
                                          Margin="0,4,0,0"
                                          Visibility="{Binding IsPushSkipDetailsExpanded, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="{StaticResource FontSizeSecondary}"
                                                   Foreground="{StaticResource InfoForeground}"
                                                   Margin="12,1,0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="4">
                        <!-- Path Move Detection Banner (§3.5 (b)) -->
                        <Border Background="{StaticResource InfoBackground}"
                                BorderBrush="{StaticResource InfoBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4"
                                Margin="0,0,0,8"
                                Visibility="{Binding HasPathMoveDetection, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Content="{Binding IsPathMoveDetailsVisible, Converter={StaticResource BoolToLabel}, ConverterParameter='접기|상세보기'}"
                                            Command="{Binding TogglePathMoveDetailsCommand}"
                                            Padding="8,4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{StaticResource InfoForeground}"
                                            FontWeight="Bold"
                                            Cursor="Hand" />
                                    <TextBlock Text="{Binding PathMoveDetectionBannerText}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource InfoForeground}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding PathMoveDetectionDetails}"
                                              Margin="0,8,0,0"
                                              Visibility="{Binding IsPathMoveDetailsVisible, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="{StaticResource FontFamilyMono}"
                                                       FontSize="{StaticResource FontSizeSecondary}"
                                                       Foreground="{StaticResource NeutralForegroundMuted}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Inaccessible Paths Panel -->
                        <Border Background="{StaticResource WarningBackground}"
                                BorderBrush="{StaticResource WarningBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4"
                                Margin="0,0,0,8"
                                Visibility="{Binding HasInaccessiblePaths, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Content="{Binding IsInaccessiblePathsExpanded, Converter={StaticResource BoolToLabel}, ConverterParameter='접기|경로 목록 보기'}"
                                            Command="{Binding ToggleInaccessiblePathsCommand}"
                                            Padding="8,4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{StaticResource WarningForeground}"
                                            FontWeight="Bold"
                                            Cursor="Hand" />
                                    <TextBlock Text="⚠️ 접근 거부된 경로가 있어 일부 레포를 건너뛰었습니다."
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource WarningForeground}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Main Split View (§5.3.1/5.3.2: 좌 디렉토리 트리 / 우 레포 리스트) / Empty States -->
                    <Grid Grid.Row="5">
                        <Grid Visibility="{Binding HasNoRepos, Converter={StaticResource InvertedBoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" MinWidth="180" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: Directory Tree (§5.3.1) -->
                            <Border Grid.Column="0"
                                    Background="{StaticResource NeutralBackground}"
                                    BorderBrush="{StaticResource NeutralBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TreeView x:Name="MainTreeView"
                                          AutomationProperties.AutomationId="TreeRepos"
                                          ItemsSource="{Binding RootTreeNodes}"
                                          BorderThickness="0"
                                          Padding="4"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.IsDeferredScrollingEnabled="False"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          AllowDrop="True"
                                          DragEnter="MainTreeView_DragEnter"
                                          DragOver="MainTreeView_DragEnter"
                                          Drop="MainTreeView_Drop"
                                          SelectedItemChanged="MainTreeView_SelectedItemChanged">

                                    <TreeView.Resources>
                                        <!-- Template for FolderTreeNodeViewModel: folder nodes only (§5.3.1);
                                             clicking navigates the right pane, no cascading checkbox (v4 discards
                                             "폴더 노드 체크 = 하위 전체 선택") -->
                                        <HierarchicalDataTemplate DataType="{x:Type tree:FolderTreeNodeViewModel}"
                                                                  ItemsSource="{Binding Children}">
                                            <DockPanel Margin="0,4" LastChildFill="True">
                                                <DockPanel.ContextMenu>
                                                    <ContextMenu AutomationProperties.AutomationId="ContextMenuFolderNode">
                                                        <MenuItem Header="탐색기에서 열기" Command="{Binding OpenInExplorerCommand}" ToolTip="Shift+클릭: 상위 폴더에서 선택" AutomationProperties.AutomationId="MenuFolderOpenInExplorer" />
                                                        <MenuItem Header="여기서 터미널 열기" Command="{Binding OpenTerminalHereCommand}" AutomationProperties.AutomationId="MenuFolderOpenTerminal" />
                                                        <Separator />
                                                        <MenuItem Header="경로 복사" Command="{Binding CopyPathCommand}" AutomationProperties.AutomationId="MenuFolderCopyPath" />
                                                        <Separator />
                                                        <MenuItem Header="{Binding IsAutoPullTarget, Converter={StaticResource BoolToLabel}, ConverterParameter='자동 pull 해제|자동 pull 등록'}"
                                                                  Command="{Binding ToggleAutoPullTargetCommand}"
                                                                  AutomationProperties.AutomationId="MenuFolderToggleAutoPull" />
                                                    </ContextMenu>
                                                </DockPanel.ContextMenu>

                                                <!-- Rollup Status Summary Badge (필터 적용 결과 기준, §2.4) -->
                                                <Border DockPanel.Dock="Right"
                                                        Background="{StaticResource WarningBackground}"
                                                        BorderBrush="{StaticResource WarningBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,4"
                                                        Margin="8,0,4,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding RollupSummaryText, Converter={StaticResource StringNotEmptyToVis}}"
                                                        ToolTip="하위 저장소 상태 롤업(현재 필터 기준): ↓ Behind 합, ↑ Ahead 합, ⚠ 확인 필요 합">
                                                    <TextBlock Text="{Binding RollupSummaryText}"
                                                               FontWeight="Bold"
                                                               FontSize="{StaticResource FontSizeSecondary}"
                                                               Foreground="{StaticResource WarningForeground}" />
                                                </Border>

                                                <!-- §8.1.1(a): 자동 pull 대상 배지 -->
                                                <Border DockPanel.Dock="Right"
                                                        Background="{StaticResource InfoBackground}"
                                                        BorderBrush="{StaticResource InfoBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="4,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsAutoPullTarget, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="예약된 시각에 자동으로 pull됩니다">
                                                    <TextBlock Text="자동 pull"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource InfoForeground}" />
                                                </Border>

                                                <!-- Folder Path -->
                                                <TextBlock Text="{Binding CompressedDisplayPath}"
                                                           FontWeight="Bold"
                                                           FontSize="{StaticResource FontSizeSubtitle}"
                                                           Foreground="{StaticResource NeutralForeground}"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                            </Border>

                            <GridSplitter Grid.Column="1"
                                          Width="6"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="{StaticResource NeutralBorder}"
                                          ResizeBehavior="PreviousAndNext" />

                            <!-- RIGHT: Flat Repo List (§5.3.2) -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="4,0,4,8" LastChildFill="False">
                                    <ToggleButton Content="직속만"
                                                  x:Name="BtnDirectChildrenOnly"
                                                  AutomationProperties.AutomationId="BtnDirectChildrenOnly"
                                                  IsChecked="{Binding DirectChildrenOnly, Mode=TwoWay}"
                                                  DockPanel.Dock="Right"
                                                  Style="{StaticResource FilterToggleButtonStyle}"
                                                  ToolTip="켜면 선택한 폴더에 직접 있는 저장소만, 끄면 하위 전체를 포함합니다(기본값)." />
                                    <TextBlock Text="{Binding SelectedLeftNode.CompressedDisplayPath, FallbackValue=전체}"
                                               FontWeight="Bold"
                                               FontSize="{StaticResource FontSizeSubtitle}"
                                               Foreground="{StaticResource NeutralForeground}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <Border Grid.Row="1"
                                        Background="{StaticResource NeutralBackground}"
                                        BorderBrush="{StaticResource NeutralBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ListBox x:Name="RightPaneRepoList"
                                             AutomationProperties.AutomationId="ListRightPaneRepos"
                                             ItemsSource="{Binding RightPaneRepos}"
                                             BorderThickness="0"
                                             Padding="4"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type tree:RepoTreeNodeViewModel}">
                                        <DockPanel Margin="0,4" LastChildFill="True">
                                            <DockPanel.ContextMenu>
                                                <ContextMenu AutomationProperties.AutomationId="ContextMenuRepoNode">
                                                    <MenuItem Header="탐색기에서 열기" Command="{Binding OpenInExplorerCommand}" ToolTip="Shift+클릭: 상위 폴더에서 선택" AutomationProperties.AutomationId="MenuRepoOpenInExplorer" />
                                                    <MenuItem Header="여기서 터미널 열기" Command="{Binding OpenTerminalHereCommand}" AutomationProperties.AutomationId="MenuRepoOpenTerminal" />
                                                    <MenuItem Header="브라우저에서 열기" Command="{Binding OpenInBrowserCommand}" IsEnabled="{Binding CanOpenInBrowser}" AutomationProperties.AutomationId="MenuRepoOpenInBrowser" />
                                                    <Separator />
                                                    <MenuItem Header="경로 복사" Command="{Binding CopyPathCommand}" AutomationProperties.AutomationId="MenuRepoCopyPath" />
                                                    <MenuItem Header="Clone URL 복사" Command="{Binding CopyCloneUrlCommand}" AutomationProperties.AutomationId="MenuRepoCopyCloneUrl" />
                                                    <MenuItem Header="사본으로 이동" Command="{Binding JumpToNextCloneCommand}" IsEnabled="{Binding HasDuplicateClones}" AutomationProperties.AutomationId="MenuRepoJumpToCopy" />
                                                    <Separator />
                                                    <MenuItem Header="Remote URL 변경..." Command="{Binding ChangeRemoteUrlCommand}" AutomationProperties.AutomationId="MenuRepoChangeRemoteUrl" />
                                                    <MenuItem Header="개별 Force Push (--force-with-lease)..." Command="{Binding ForcePushCommand}" AutomationProperties.AutomationId="MenuRepoForcePush" />
                                                    <MenuItem Header="개별 Push (-u)..." Command="{Binding PushNoUpstreamCommand}" AutomationProperties.AutomationId="MenuRepoPushNoUpstream" />
                                                </ContextMenu>
                                            </DockPanel.ContextMenu>

                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0" />

                                            <!-- Host profile color dot (●) -->
                                            <TextBlock Text="●"
                                                       Foreground="{Binding HostDotColor}"
                                                       FontSize="{StaticResource FontSizeSubtitle}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       ToolTip="{Binding HostName, StringFormat='서버 프로파일: {0}'}" />

                                            <!-- Right-aligned Badges: Server Status, Suggestions, Freshness, 3-Axis Summary, Duplicate, Nested Warning -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- LFS Badge (§9.4, 완료 기준 33) -->
                                                <Border Background="{StaticResource InfoBackground}"
                                                        BorderBrush="{StaticResource InfoBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="4,4"
                                                        Margin="4,0"
                                                        Visibility="{Binding HasLfsBadge, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Git LFS(대용량 파일 저장) 저장소입니다. 저동시성 큐로 처리됩니다.">
                                                    <TextBlock Text="LFS" FontWeight="Bold" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource InfoForeground}" />
                                                </Border>

                                                <!-- Worktree / Bare Badge (§9.4, 완료 기준 33) -->
                                                <Border Background="{StaticResource InfoBackground}"
                                                        BorderBrush="{StaticResource InfoBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="4,4"
                                                        Margin="4,0"
                                                        Visibility="{Binding HasWorktreeBadge, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="worktree/bare 저장소는 일괄 작업 대상에서 제외됩니다.">
                                                    <TextBlock Text="{Binding WorktreeBadgeText}" FontWeight="Bold" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource InfoForeground}" />
                                                </Border>

                                                <!-- Server Status Badge (Orphaned / External / Untracked / Archived) (§3.2) -->
                                                <Border Background="{StaticResource WarningBackground}"
                                                        BorderBrush="{StaticResource WarningBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="4,4"
                                                        Margin="4,0"
                                                        Visibility="{Binding HasServerStatusBadge, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="{Binding ServerStatusBadge, Converter={StaticResource StateExplanation}}">
                                                    <TextBlock Text="{Binding ServerStatusBadge}"
                                                               FontWeight="Bold"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               Foreground="{StaticResource WarningForeground}" />
                                                </Border>

                                                <!-- Missing Confirmation Badge (§3.2.2 (b): local_repos.is_missing) -->
                                                <Border Background="{StaticResource ErrorBackground}"
                                                        BorderBrush="{StaticResource ErrorBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="4,4"
                                                        Margin="4,0"
                                                        Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="활성 스캔 루트 아래인데 이번 스캔에서 보이지 않았습니다. 권한 문제이거나 네트워크 드라이브가 끊겼을 수 있어 자동으로 지우지 않습니다.">
                                                    <TextBlock Text="{Binding MissingBadgeText}"
                                                               FontWeight="Bold"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               Foreground="{StaticResource ErrorForeground}" />
                                                </Border>

                                                <!-- Upstream Gone Suggestion Button (§3.4, 완료 기준 14) -->
                                                <Button Content="{Binding UpstreamGoneSuggestionText}"
                                                        Command="{Binding SetUpstreamGoneCommand}"
                                                        Background="{StaticResource WarningBackground}"
                                                        BorderBrush="{StaticResource WarningBorder}"
                                                        Foreground="{StaticResource WarningForeground}"
                                                        FontWeight="Bold"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        Padding="4,4"
                                                        Margin="4,0"
                                                        Cursor="Hand"
                                                        AutomationProperties.AutomationId="BtnTreeUpstreamGoneSuggestion"
                                                        Visibility="{Binding HasUpstreamGoneSuggestion, Converter={StaticResource BoolToVis}}" />

                                                <!-- URL Change Suggestion Button (§3.5, 완료 기준 16) -->
                                                <Button Content="🔄 URL 변경 감지"
                                                        Command="{Binding ApplyUrlChangeCommand}"
                                                        ToolTip="{Binding UrlChangeSuggestionText}"
                                                        Background="{StaticResource InfoBackground}"
                                                        BorderBrush="{StaticResource InfoBorder}"
                                                        Foreground="{StaticResource InfoForeground}"
                                                        FontWeight="Bold"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        Padding="4,4"
                                                        Margin="4,0"
                                                        Cursor="Hand"
                                                        AutomationProperties.AutomationId="BtnTreeUrlChangeSuggestion"
                                                        Visibility="{Binding HasUrlChangeSuggestion, Converter={StaticResource BoolToVis}}" />

                                                <!-- Nested Repo Boundary Warning -->
                                                <Border Background="{StaticResource ErrorBackground}"
                                                        BorderBrush="{StaticResource ErrorBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="4,4"
                                                        Margin="4,0"
                                                        Visibility="{Binding HasGitIgnoreWarning, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="자식 저장소가 부모의 .gitignore에 없으면 부모의 Dirty 판정이 자식 파일로 오염될 수 있습니다.">
                                                    <TextBlock Text="⚠️ .gitignore 누락"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource ErrorForeground}" />
                                                </Border>

                                                <!-- Duplicate Clones Badge -->
                                                <Button Content="{Binding DuplicateBadgeText}"
                                                        Command="{Binding JumpToNextCloneCommand}"
                                                        Background="{StaticResource InfoBackground}"
                                                        BorderBrush="{StaticResource InfoBorder}"
                                                        Foreground="{StaticResource InfoForeground}"
                                                        FontWeight="SemiBold"
                                                        FontSize="{StaticResource FontSizeSecondary}"
                                                        Padding="8,4"
                                                        Margin="4,0"
                                                        Cursor="Hand"
                                                        ToolTip="클릭하면 이 URL의 다른 로컬 사본으로 이동합니다."
                                                        Visibility="{Binding HasDuplicateClones, Converter={StaticResource BoolToVis}}" />

                                                <!-- 3-Axis Status Badge -->
                                                <Border Background="{StaticResource NeutralSurface}"
                                                        BorderBrush="{StaticResource NeutralBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="8,4"
                                                        Margin="4,0"
                                                        ToolTip="{Binding ThreeAxisSummary, Converter={StaticResource StateExplanation}}">
                                                    <TextBlock Text="{Binding ThreeAxisSummary}"
                                                               FontWeight="SemiBold"
                                                               FontSize="{StaticResource FontSizeSecondary}"
                                                               Foreground="{StaticResource NeutralForeground}" />
                                                </Border>

                                                <!-- Freshness Label -->
                                                <TextBlock Text="{Binding Freshness}"
                                                           Foreground="{StaticResource NeutralForegroundMuted}"
                                                           FontSize="{StaticResource FontSizeSecondary}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,8,0"
                                                           MinWidth="80"
                                                           TextAlignment="Right"
                                                           ToolTip="마지막 fetch 이후 경과 시간. Fetch 전까지는 Behind 판정이 부정확할 수 있습니다." />
                                            </StackPanel>

                                            <!-- Repo Name, Remote Key, Branch -->
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FolderName}"
                                                               FontWeight="Bold"
                                                               FontSize="{StaticResource FontSizeSubtitle}"
                                                               Foreground="{StaticResource NeutralForeground}"
                                                               TextDecorations="{Binding IsMissing, Converter={StaticResource BoolToStrikethrough}}" />
                                                    <TextBlock Text="{Binding DisplayRepoPath, Converter={StaticResource FrontEllipsis}, ConverterParameter=60}"
                                                               FontFamily="{StaticResource FontFamilyMono}"
                                                               FontSize="{StaticResource FontSizeSecondary}"
                                                               Foreground="{StaticResource NeutralForegroundMuted}"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               TextDecorations="{Binding IsMissing, Converter={StaticResource BoolToStrikethrough}}"
                                                               ToolTip="{Binding DisplayRepoPath}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding BranchDisplay}"
                                                           FontFamily="{StaticResource FontFamilyMono}"
                                                           FontSize="{StaticResource FontSizeSecondary}"
                                                           Foreground="{StaticResource NeutralForegroundMuted}"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Empty State 1: 스캔 루트 없음 -->
                        <Border Background="{StaticResource NeutralBackground}"
                                BorderBrush="{StaticResource NeutralBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="32"
                                Visibility="{Binding HasNoRepos, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="등록된 저장소가 없습니다"
                                           FontSize="{StaticResource FontSizeTitle}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NeutralForeground}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="스캔할 폴더를 선택하거나, 트리 영역으로 폴더를 끌어다 놓으세요."
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{StaticResource NeutralForegroundMuted}"
                                           Margin="0,8,0,12"
                                           HorizontalAlignment="Center" />
                                <Button Content="스캔 폴더 추가"
                                        Padding="16,8"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Click="BrowseFolder_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Empty State 2: 필터 결과 0건 (스캔 루트는 있으나 필터로 전부 가려짐) -->
                        <Border Background="{StaticResource NeutralBackground}"
                                BorderBrush="{StaticResource NeutralBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="32"
                                Visibility="{Binding HasNoFilterResults, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="조건에 맞는 저장소가 없습니다"
                                           FontSize="{StaticResource FontSizeTitle}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NeutralForeground}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="검색어 또는 필터 조건을 확인하세요."
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{StaticResource NeutralForegroundMuted}"
                                           Margin="0,8,0,12"
                                           HorizontalAlignment="Center" />
                                <Button Content="필터 해제"
                                        Command="{Binding ClearFiltersCommand}"
                                        Padding="16,8"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Pull Execution Panel (Phase 3) -->
                    <Border Grid.Row="6"
                            x:Name="PanelPullExecution"
                            AutomationProperties.AutomationId="PanelPullExecution"
                            Background="{Binding PullPanelBackground}"
                            BorderBrush="{Binding PullPanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,8,0,0"
                            Visibility="{Binding IsPullPanelVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="120" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        x:Name="BtnCancelPull"
                                        AutomationProperties.AutomationId="BtnCancelPull"
                                        Content="실행 취소"
                                        Command="{Binding CancelPullCommand}"
                                        Visibility="{Binding IsPullExecuting, Converter={StaticResource BoolToVis}}"
                                        Padding="8,4"
                                        Style="{StaticResource DangerButtonStyle}" />
                                <Button DockPanel.Dock="Right"
                                        x:Name="BtnClosePullPanel"
                                        AutomationProperties.AutomationId="BtnClosePullPanel"
                                        Content="✕ 닫기"
                                        Command="{Binding ClosePullPanelCommand}"
                                        Visibility="{Binding IsPullCompleted, Converter={StaticResource BoolToVis}}"
                                        Padding="8,4"
                                        Background="{StaticResource NeutralBorder}"
                                        BorderBrush="{StaticResource NeutralBorder}"
                                        Foreground="{StaticResource NeutralForeground}"
                                        FontWeight="Bold" />
                                <TextBlock Text="{Binding PullHeaderTitle}" FontWeight="Bold" FontSize="{StaticResource FontSizeSubtitle}" Foreground="{Binding PullHeaderColor}" VerticalAlignment="Center" />
                            </DockPanel>

                            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                <ProgressBar Height="16"
                                             Value="{Binding PullProgressPercent}"
                                             Maximum="100"
                                             Foreground="{StaticResource AccentBackground}"
                                             Background="{StaticResource NeutralBorder}" />
                                <TextBlock Text="{Binding PullProgressText}" AutomationProperties.AutomationId="TxtPullSummaryReport" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{StaticResource NeutralForegroundMuted}" Margin="0,4,0,0" />
                            </StackPanel>

                            <ListBox Grid.Row="2"
                                     x:Name="ListPullExecution"
                                     AutomationProperties.AutomationId="ListPullExecution"
                                     ItemsSource="{Binding PullExecutionItems}"
                                     Background="{StaticResource NeutralBackground}"
                                     BorderBrush="{StaticResource NeutralBorder}"
                                     BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="4,4">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DurationMs, StringFormat='({0}ms)'}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource NeutralForegroundMuted}" Margin="8,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontWeight="Bold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{Binding StatusColor}" />
                                            <TextBlock Text="{Binding RepoPath, Converter={StaticResource FrontEllipsis}, ConverterParameter=70}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeSecondary}" ToolTip="{Binding RepoPath}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Categorized Failures & Selective Retry (§10.2, 완료 기준 4, 5) -->
                            <ItemsControl Grid.Row="3" ItemsSource="{Binding PullErrorGroups}" Margin="0,8,0,0"
                                          Visibility="{Binding HasPullErrorGroups, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource ErrorBackground}" BorderBrush="{StaticResource ErrorBorder}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,0">
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right"
                                                        x:Name="BtnRetryPullGroup"
                                                        AutomationProperties.AutomationId="BtnRetryPullGroup"
                                                        Content="이 유형만 재시도"
                                                        Command="{Binding RetryCommand}"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                                                        Padding="8,4" Style="{StaticResource DangerButtonStyle}" />
                                                <StackPanel Orientation="Vertical">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding CategoryName, StringFormat='🚨 {0}'}" FontWeight="Bold" Foreground="{StaticResource ErrorForeground}" />
                                                        <TextBlock Text="{Binding FailedCount, StringFormat='({0}건 실패)'}" FontWeight="Bold" Foreground="{StaticResource ErrorForeground}" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding GuideMessage}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{StaticResource ErrorForeground}" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Push Execution Panel (§8.2, §8.3) -->
                    <Border Grid.Row="7"
                            x:Name="PanelPushExecution"
                            AutomationProperties.AutomationId="PanelPushExecution"
                            Background="{Binding PushPanelBackground}"
                            BorderBrush="{Binding PushPanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,8,0,0"
                            Visibility="{Binding IsPushPanelVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="120" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        x:Name="BtnCancelPushExecution"
                                        AutomationProperties.AutomationId="BtnCancelPushExecution"
                                        Content="실행 취소"
                                        Command="{Binding CancelPushCommand}"
                                        Visibility="{Binding IsPushExecuting, Converter={StaticResource BoolToVis}}"
                                        Padding="8,4"
                                        Style="{StaticResource DangerButtonStyle}" />
                                <Button DockPanel.Dock="Right"
                                        x:Name="BtnClosePushPanel"
                                        AutomationProperties.AutomationId="BtnClosePushPanel"
                                        Content="✕ 닫기"
                                        Command="{Binding ClosePushPanelCommand}"
                                        Visibility="{Binding IsPushCompleted, Converter={StaticResource BoolToVis}}"
                                        Padding="8,4"
                                        Background="{StaticResource NeutralBorder}"
                                        BorderBrush="{StaticResource NeutralBorder}"
                                        Foreground="{StaticResource NeutralForeground}"
                                        FontWeight="Bold" />
                                <TextBlock Text="{Binding PushHeaderTitle}" FontWeight="Bold" FontSize="{StaticResource FontSizeSubtitle}" Foreground="{Binding PushHeaderColor}" VerticalAlignment="Center" />
                            </DockPanel>

                            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                <ProgressBar Height="16"
                                             Value="{Binding PushProgressPercent}"
                                             Maximum="100"
                                             Foreground="{StaticResource AccentBackground}"
                                             Background="{StaticResource NeutralBorder}" />
                                <TextBlock Text="{Binding PushProgressText}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{StaticResource NeutralForegroundMuted}" Margin="0,4,0,0" />
                            </StackPanel>

                            <ListBox Grid.Row="2"
                                     x:Name="ListPushExecution"
                                     AutomationProperties.AutomationId="ListPushExecution"
                                     ItemsSource="{Binding PushExecutionItems}"
                                     Background="{StaticResource NeutralBackground}"
                                     BorderBrush="{StaticResource NeutralBorder}"
                                     BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="4,4">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusBadgeText}" FontWeight="Bold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{Binding StatusBadgeColor}" Margin="8,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource NeutralForegroundMuted}" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding AbsPath, Converter={StaticResource FrontEllipsis}, ConverterParameter=70}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeSecondary}" ToolTip="{Binding AbsPath}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Categorized Failures & Selective Retry (§10.2, 완료 기준 4, 5, 7) -->
                            <ItemsControl Grid.Row="3" ItemsSource="{Binding PushErrorGroups}" Margin="0,8,0,0"
                                          Visibility="{Binding HasPushErrorGroups, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource ErrorBackground}" BorderBrush="{StaticResource ErrorBorder}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,0">
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right"
                                                        x:Name="BtnRetryPushGroup"
                                                        AutomationProperties.AutomationId="BtnRetryPushGroup"
                                                        Content="이 유형만 재시도"
                                                        Command="{Binding RetryCommand}"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                                                        Padding="8,4" Style="{StaticResource DangerButtonStyle}" />
                                                <StackPanel Orientation="Vertical">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding CategoryName, StringFormat='🚨 {0}'}" FontWeight="Bold" Foreground="{StaticResource ErrorForeground}" />
                                                        <TextBlock Text="{Binding FailedCount, StringFormat='({0}건 실패)'}" FontWeight="Bold" Foreground="{StaticResource ErrorForeground}" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding GuideMessage}" FontSize="{StaticResource FontSizeSecondary}" Foreground="{StaticResource ErrorForeground}" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Job History Panel (§10.3, 완료 기준 8~13) -->
                    <Border Grid.Row="8"
                            x:Name="PanelJobHistory"
                            AutomationProperties.AutomationId="PanelJobHistory"
                            Background="{StaticResource NeutralSurface}"
                            BorderBrush="{StaticResource NeutralBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,8,0,0"
                            Visibility="{Binding IsHistoryPanelVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="200" />
                            </Grid.RowDefinitions>

                            <!-- Top Header & Filter Toolbar -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        x:Name="BtnCloseJobHistory"
                                        AutomationProperties.AutomationId="BtnCloseJobHistory"
                                        Content="✕ 닫기"
                                        Command="{Binding ToggleHistoryPanelCommand}"
                                        Padding="8,4"
                                        Style="{StaticResource SecondaryButtonStyle}" />

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="작업 유형:" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" />
                                    <ComboBox x:Name="CmbJobTypeFilter"
                                              AutomationProperties.AutomationId="CmbJobTypeFilter"
                                              ItemsSource="{Binding AvailableJobTypes}"
                                              SelectedItem="{Binding SelectedJobTypeFilter, Mode=TwoWay}"
                                              Width="130"
                                              Padding="4,4"
                                              Margin="0,0,8,0" />

                                    <ToggleButton x:Name="BtnToggleFullHistory"
                                                  AutomationProperties.AutomationId="BtnToggleFullHistory"
                                                  Content="전체 이력 보기"
                                                  IsChecked="{Binding IsFullHistoryMode, Mode=TwoWay}"
                                                  Command="{Binding ToggleFullHistoryCommand}"
                                                  Padding="8,4"
                                                  Style="{StaticResource FilterToggleButtonStyle}" />
                                </StackPanel>

                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📋 작업 이력 (Job History)" FontWeight="Bold" FontSize="{StaticResource FontSizeSubtitle}" Foreground="{StaticResource NeutralForeground}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Text="경로 검색:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="{StaticResource FontSizeSecondary}" />
                                    <TextBox x:Name="TxtHistorySearch"
                                             AutomationProperties.AutomationId="TxtHistorySearch"
                                             Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Width="160"
                                             Padding="4,4" />
                                </WrapPanel>
                            </DockPanel>

                            <!-- History DataGrid with Rollback Buttons -->
                            <DataGrid Grid.Row="1"
                                      x:Name="GridJobHistory"
                                      AutomationProperties.AutomationId="GridJobHistory"
                                      ItemsSource="{Binding JobHistoryItems}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource NeutralSurface}"
                                      Background="{StaticResource NeutralBackground}"
                                      BorderBrush="{StaticResource NeutralBorder}"
                                      BorderThickness="1">
                                <DataGrid.Columns>
                                    <!-- ID -->
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45" />

                                    <!-- Job Type -->
                                    <DataGridTextColumn Header="작업 유형" Binding="{Binding JobType}" Width="110" />

                                    <!-- Target Path -->
                                    <DataGridTextColumn Header="대상 저장소" Binding="{Binding TargetPath, Converter={StaticResource FrontEllipsis}, ConverterParameter=40}" Width="200">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
                                                <Setter Property="ToolTip" Value="{Binding TargetPath}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Head / URL Transition -->
                                    <DataGridTextColumn Header="변경 전 → 변경 후" Binding="{Binding HeadTransition}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Result -->
                                    <DataGridTemplateColumn Header="결과" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Result}" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessForeground}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Result}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{StaticResource ErrorForeground}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Error Category -->
                                    <DataGridTextColumn Header="오류 분류" Binding="{Binding ErrorCategory}" Width="100" />

                                    <!-- Time -->
                                    <DataGridTextColumn Header="실행 시각" Binding="{Binding TimeFormatted}" Width="135" />

                                    <!-- Rollback Action Column (§10.3, 완료 기준 10, 12) -->
                                    <DataGridTemplateColumn Header="되돌리기" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button x:Name="BtnRollbackCommit"
                                                        AutomationProperties.AutomationId="BtnRollbackCommit"
                                                        Content="이 커밋으로 되돌리기"
                                                        Command="{Binding RollbackCommand}"
                                                        Visibility="{Binding CanRollback, Converter={StaticResource BoolToVis}}"
                                                        Padding="8,4"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        ToolTip="git reset --hard로 이 커밋 시점으로 되돌립니다(개별 실행, 확인 필수)." />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Selection Basket Panel (§5.3.4) -->
                    <Border Grid.Row="9"
                            x:Name="PanelSelectionBasket"
                            AutomationProperties.AutomationId="PanelSelectionBasket"
                            Background="{StaticResource NeutralSurface}"
                            BorderBrush="{StaticResource NeutralBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,8,0,0"
                            Visibility="{Binding IsSelectionBasketVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="200" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Content="✕ 닫기"
                                        Command="{Binding ToggleSelectionBasketCommand}"
                                        Padding="8,4"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button DockPanel.Dock="Right"
                                        x:Name="BtnClearSelectionBasket"
                                        AutomationProperties.AutomationId="BtnClearSelectionBasket"
                                        Content="전체 해제"
                                        Command="{Binding DeselectAllCommand}"
                                        Padding="8,4"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <TextBlock Text="{Binding ExecutionSummaryText}"
                                           FontWeight="Bold"
                                           FontSize="{StaticResource FontSizeSubtitle}"
                                           Foreground="{StaticResource NeutralForeground}"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Auto-removal notices: 재스캔에서 is_missing이 된 선택 항목 (§5.3.4) -->
                            <ItemsControl Grid.Row="1"
                                          AutomationProperties.AutomationId="ListSelectionRemovalNotices"
                                          ItemsSource="{Binding SelectionRemovalNotices}"
                                          Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource WarningForeground}"
                                                   FontSize="{StaticResource FontSizeSecondary}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Grid.Row="2"
                                    Background="{StaticResource NeutralBackground}"
                                    BorderBrush="{StaticResource NeutralBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <ListBox x:Name="ListSelectionBasket"
                                         AutomationProperties.AutomationId="ListSelectionBasket"
                                         ItemsSource="{Binding SelectionBasket}"
                                         BorderThickness="0"
                                         Padding="4"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type tree:RepoTreeNodeViewModel}">
                                            <DockPanel Margin="0,2" LastChildFill="True">
                                                <Button DockPanel.Dock="Right"
                                                        Content="✕"
                                                        Command="{Binding DataContext.RemoveFromSelectionBasketCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="6,2"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{StaticResource NeutralForegroundMuted}"
                                                        Cursor="Hand"
                                                        ToolTip="바구니에서 이 레포만 제거" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding ThreeAxisSummary}"
                                                           Margin="8,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource NeutralForegroundMuted}"
                                                           FontSize="{StaticResource FontSizeSecondary}" />
                                                <TextBlock Text="{Binding FullPath}"
                                                           FontFamily="{StaticResource FontFamilyMono}"
                                                           FontSize="{StaticResource FontSizeSecondary}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FullPath}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Legend Panel (§5.5) -->
                    <Border Grid.Row="10"
                            x:Name="PanelLegend"
                            AutomationProperties.AutomationId="PanelLegend"
                            Background="{StaticResource NeutralSurface}"
                            BorderBrush="{StaticResource NeutralBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,8,0,0"
                            Visibility="{Binding IsLegendVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Content="✕ 닫기"
                                        Command="{Binding ToggleLegendCommand}"
                                        Padding="8,4"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <TextBlock Text="❓ 범례" FontWeight="Bold" FontSize="{StaticResource FontSizeSubtitle}" Foreground="{StaticResource NeutralForeground}" VerticalAlignment="Center" />
                            </DockPanel>

                            <ItemsControl>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Resources>
                                    <Style TargetType="Border" x:Key="LegendRowStyle">
                                        <Setter Property="Padding" Value="6,4" />
                                        <Setter Property="Margin" Value="0,0,8,4" />
                                    </Style>
                                </ItemsControl.Resources>

                                <!-- [동기화] -->
                                <Border Style="{StaticResource LegendRowStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="최신" FontWeight="Bold" Width="190" /><TextBlock Text="로컬이 원격과 같음 — pull 불필요" Foreground="{StaticResource NeutralForegroundMuted}" /></StackPanel></Border>
                                <Border Style="{StaticResource LegendRowStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="받을 것 있음 ↓N" FontWeight="Bold" Width="190" /><TextBlock Text="원격에 새 커밋 N개 — pull 가능" Foreground="{StaticResource SuccessForeground}" /></StackPanel></Border>
                                <Border Style="{StaticResource LegendRowStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="올릴 것 있음 ↑N" FontWeight="Bold" Width="190" /><TextBlock Text="로컬에만 커밋 N개 — push 대상, pull 불필요" Foreground="{StaticResource NeutralForegroundMuted}" /></StackPanel></Border>
                                <Border Style="{StaticResource LegendRowStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="갈라짐 · pull 먼저 필요" FontWeight="Bold" Width="190" /><TextBlock Text="로컬/원격이 각자 다른 커밋 — pull 차단" Foreground="{StaticResource ErrorForeground}" /></StackPanel></Border>
                                <Border Style="{StaticResource LegendRowStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="추적 브랜치 없음" FontWeight="Bold" Width="190" /><TextBlock Text="upstream 미설정 — pull 차단" Foreground="{StaticResource ErrorForeground}" /></StackPanel></Border>
                                <Border Style="{StaticResource LegendRowStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="서버에서 사라진 브랜치" FontWeight="Bold" Width="190" /><TextBlock Text="추적하던 원격 브랜치가 삭제됨 — pull 차단" Foreground="{StaticResource ErrorForeground}" /></StackPanel></Border>
                                <Border Style="{StaticResource LegendRowStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="브랜치 미체크아웃" FontWeight="Bold" Width="190" /><TextBlock Text="detached HEAD — pull 차단" Foreground="{StaticResource ErrorForeground}" /></StackPanel></Border>

                                <!-- 카탈로그 매칭 -->
                                <Border Style="{StaticResource LegendRowStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="로컬 없음" FontWeight="Bold" Width="190" /><TextBlock Text="서버에는 있으나 로컬에 없음(클론 탭)" Foreground="{StaticResource NeutralForegroundMuted}" /></StackPanel></Border>
                                <Border Style="{StaticResource LegendRowStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="카탈로그에 없음" FontWeight="Bold" Width="190" /><TextBlock Text="이 호스트 프로파일인데 카탈로그에서 못 찾음 — pull 가능" Foreground="{StaticResource SuccessForeground}" /></StackPanel></Border>
                                <Border Style="{StaticResource LegendRowStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="미등록 호스트" FontWeight="Bold" Width="190" /><TextBlock Text="등록된 서버 프로파일에 없는 호스트 — pull 가능" Foreground="{StaticResource SuccessForeground}" /></StackPanel></Border>
                                <Border Style="{StaticResource LegendRowStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="remote 없음" FontWeight="Bold" Width="190" /><TextBlock Text="로컬 전용, remote 자체가 없음" Foreground="{StaticResource NeutralForegroundMuted}" /></StackPanel></Border>

                                <!-- [작업트리] -->
                                <Border Style="{StaticResource LegendRowStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="미커밋 변경 N" FontWeight="Bold" Width="190" /><TextBlock Text="dirty 파일 N개 — pull 차단(§3.3 push는 미커밋분 제외 후 허용)" Foreground="{StaticResource ErrorForeground}" /></StackPanel></Border>
                                <Border Style="{StaticResource LegendRowStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="머지 충돌 N" FontWeight="Bold" Width="190" /><TextBlock Text="conflicted 파일 N개 — pull/push 모두 차단" Foreground="{StaticResource ErrorForeground}" /></StackPanel></Border>

                                <!-- 독립 배지 -->
                                <Border Style="{StaticResource LegendRowStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="보관됨" FontWeight="Bold" Width="190" /><TextBlock Text="서버에서 보관 처리된 레포(3축과 별개의 독립 배지)" Foreground="{StaticResource NeutralForegroundMuted}" /></StackPanel></Border>
                                <Border Style="{StaticResource LegendRowStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="확인 안 됨" FontWeight="Bold" Width="190" /><TextBlock Text="스캔에서 안 보였으나 삭제하지 않음(is_missing) — pull 차단" Foreground="{StaticResource ErrorForeground}" /></StackPanel></Border>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: 클론 (Phase 4) -->
            <TabItem Header="📥 클론"
                     FontSize="{StaticResource FontSizeSubtitle}"
                     FontWeight="SemiBold"
                     Padding="16,8"
                     AutomationProperties.AutomationId="TabClone"
                     DataContext="{Binding CloneTab}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Profile Selection & Actions Bar -->
                        <RowDefinition Height="Auto" /> <!-- Permanent Scan Root Banner -->
                        <RowDefinition Height="Auto" /> <!-- Search, Filter & Multi-select Toolbar -->
                        <RowDefinition Height="*" />    <!-- Catalog DataGrid / Empty State -->
                        <RowDefinition Height="Auto" /> <!-- Destination Root & Execute Bar -->
                    </Grid.RowDefinitions>

                    <!-- Top Profile Selection & Management Bar -->
                    <Border Grid.Row="0"
                            Background="{StaticResource NeutralBackground}"
                            BorderBrush="{StaticResource NeutralBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="⚙️ 프로파일 관리..."
                                        x:Name="BtnOpenProfileManagement"
                                        AutomationProperties.AutomationId="BtnOpenProfileManagement"
                                        Command="{Binding OpenProfileManagementCommand}"
                                        Padding="8,4"
                                        Margin="0,0,8,0"
                                        Background="{StaticResource NeutralSurface}"
                                        BorderBrush="{StaticResource NeutralBorder}"
                                        FontWeight="SemiBold" />

                                <Button Content="🔄 카탈로그 동기화"
                                        x:Name="BtnSyncCatalog"
                                        AutomationProperties.AutomationId="BtnSyncCatalog"
                                        Command="{Binding SyncCatalogCommand}"
                                        IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBool}}"
                                        Padding="12,4"
                                        Style="{StaticResource AccentButtonStyle}"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="이미 동기화가 진행 중일 때는 비활성화됩니다." />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="서버 프로파일:"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding ServerProfiles}"
                                          SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                          DisplayMemberPath="Host"
                                          Width="220"
                                          Padding="8,4"
                                          x:Name="CmbCloneProfile"
                                          AutomationProperties.AutomationId="CmbCloneProfile" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Permanent Scan Root Banner (§7.5, §10 Criterion 24) -->
                    <Border Grid.Row="1"
                            Background="{StaticResource SuccessBackground}"
                            BorderBrush="{StaticResource SuccessBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,0,0,8">
                        <TextBlock x:Name="TxtScanRootBanner"
                                   AutomationProperties.AutomationId="TxtScanRootBanner"
                                   Text="{Binding ScanRootBannerText}"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource SuccessForeground}" />
                    </Border>

                    <!-- Filter & Selection Bar -->
                    <Border Grid.Row="2"
                            Background="{StaticResource NeutralBackground}"
                            BorderBrush="{StaticResource NeutralBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCloneSelectionSummary"
                                           AutomationProperties.AutomationId="TxtCloneSelectionSummary"
                                           Text="{Binding SelectionSummaryText}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                            </StackPanel>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="검색:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="TxtCloneFilter"
                                         AutomationProperties.AutomationId="TxtCloneFilter"
                                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         Width="180"
                                         Padding="4,4"
                                         Margin="0,0,12,0" />

                                <CheckBox x:Name="ChkShowArchived"
                                          AutomationProperties.AutomationId="ChkShowArchived"
                                          Content="보관된(Archived) 레포 표시"
                                          IsChecked="{Binding ShowArchived, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          FontWeight="SemiBold"
                                          Margin="0,0,12,0" />

                                <!-- §5.4.2: 기본 진입점 -->
                                <ToggleButton x:Name="BtnShowNotClonedOnly"
                                              AutomationProperties.AutomationId="BtnShowNotClonedOnly"
                                              Content="로컬에 없는 것만"
                                              IsChecked="{Binding ShowNotClonedOnly, Mode=TwoWay}"
                                              Style="{StaticResource FilterToggleButtonStyle}"
                                              Margin="0,0,12,0"
                                              ToolTip="확인 안 됨(is_missing)으로 표시된 레포도 여기 포함됩니다." />

                                <Button Content="전체 선택"
                                        x:Name="BtnSelectAllCatalog"
                                        AutomationProperties.AutomationId="BtnSelectAllCatalog"
                                        Command="{Binding SelectAllCommand}"
                                        Padding="8,4"
                                        Margin="4,0"
                                        Style="{StaticResource SecondaryButtonStyle}" />

                                <Button Content="선택 해제"
                                        x:Name="BtnUnselectAllCatalog"
                                        AutomationProperties.AutomationId="BtnUnselectAllCatalog"
                                        Command="{Binding UnselectAllCommand}"
                                        Padding="8,4"
                                        Margin="4,0"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <!-- Namespace Tree / Catalog DataGrid Split (§5.4.1/5.4.2) / Empty State 2 -->
                    <Grid Grid.Row="3">
                        <Grid Visibility="{Binding HasNoProfiles, Converter={StaticResource InvertedBoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" MinWidth="160" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: Namespace Tree (§5.4.1) -->
                            <Border Grid.Column="0"
                                    Background="{StaticResource NeutralBackground}"
                                    BorderBrush="{StaticResource NeutralBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TreeView x:Name="CloneNamespaceTree"
                                          AutomationProperties.AutomationId="TreeNamespace"
                                          ItemsSource="{Binding NamespaceTreeRoots}"
                                          BorderThickness="0"
                                          Padding="4"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          SelectedItemChanged="CloneNamespaceTree_SelectedItemChanged">
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type vm:NamespaceTreeNodeViewModel}"
                                                                  ItemsSource="{Binding Children}">
                                            <DockPanel Margin="0,4" LastChildFill="True">
                                                <Border DockPanel.Dock="Right"
                                                        Background="{StaticResource WarningBackground}"
                                                        BorderBrush="{StaticResource WarningBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="8,0,4,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RollupSummaryText}"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource WarningForeground}" />
                                                </Border>
                                                <TextBlock Text="{Binding Segment}"
                                                           FontWeight="Bold"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           Foreground="{StaticResource NeutralForeground}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                            </Border>

                            <GridSplitter Grid.Column="1"
                                          Width="6"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="{StaticResource NeutralBorder}"
                                          ResizeBehavior="PreviousAndNext" />

                            <!-- RIGHT: Catalog DataGrid -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource NeutralBackground}"
                                    BorderBrush="{StaticResource NeutralBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <DataGrid x:Name="GridCatalog"
                                          AutomationProperties.AutomationId="GridCatalog"
                                          ItemsSource="{Binding FilteredCatalogItems}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{StaticResource NeutralSurface}"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <!-- Checkbox Column -->
                                        <DataGridTemplateColumn Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Namespace / Name -->
                                        <DataGridTemplateColumn Header="네임스페이스 / 저장소" Width="220">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Repo.NormalizedKey}" FontWeight="Bold" Foreground="{StaticResource NeutralForeground}" />
                                                        <TextBlock Text="{Binding Repo.Namespace, StringFormat='네임스페이스: {0}'}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource NeutralForegroundMuted}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Default Branch -->
                                        <DataGridTextColumn Header="기본 브랜치"
                                                            Binding="{Binding Repo.DefaultBranch}"
                                                            Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Status / Badges Column (§3.2.2) -->
                                        <DataGridTemplateColumn Header="상태 배지" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Archived Badge -->
                                                        <Border Background="{StaticResource ErrorBackground}" BorderBrush="{StaticResource ErrorBorder}" BorderThickness="1"
                                                                CornerRadius="3" Padding="4,4" Margin="0,0,4,0"
                                                                Visibility="{Binding IsArchived, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="보관됨" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold" Foreground="{StaticResource ErrorForeground}" />
                                                        </Border>

                                                        <!-- Not Cloned Badge (§3.2.2 — "빈칸 금지"의 대표 사례) -->
                                                        <Border Background="{StaticResource NeutralSurface}"
                                                                BorderBrush="{StaticResource NeutralBorder}"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Padding="6,4"
                                                                Margin="0,0,4,0"
                                                                Visibility="{Binding IsNotCloned, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding NotClonedBadgeText}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="{StaticResource FontSizeSecondary}"
                                                                       Foreground="{StaticResource NeutralForeground}" />
                                                        </Border>

                                                        <!-- Missing Confirmation Badge (§3.2.2 (b): 로컬 기록은 있으나 전부 is_missing) -->
                                                        <Border Background="{StaticResource ErrorBackground}"
                                                                BorderBrush="{StaticResource ErrorBorder}"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Padding="6,4"
                                                                Margin="0,0,4,0"
                                                                Visibility="{Binding IsAllLocalMissing, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding MissingBadgeText}"
                                                                       FontWeight="Bold"
                                                                       FontSize="{StaticResource FontSizeSecondary}"
                                                                       Foreground="{StaticResource ErrorForeground}" />
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Local Path Column (§5.4.2) -->
                                        <DataGridTemplateColumn Header="로컬 경로" Width="240">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding LocalPathPrimaryDisplay}"
                                                            Command="{Binding DataContext.JumpToLocalRepoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding HasAnyLocalRecord, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="{Binding LocalPathTooltip}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="0"
                                                            Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
                                                                <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
                                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                                <Setter Property="TextDecorations" Value="{Binding PrimaryPathIsMissing, Converter={StaticResource BoolToStrikethrough}}" />
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Clone URL -->
                                        <DataGridTextColumn Header="Clone URL (토큰 미포함)"
                                                            Binding="{Binding Repo.CloneUrl}"
                                                            Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>

                        <!-- Empty State 3: 서버 프로파일 없음 -->
                        <Border Background="{StaticResource NeutralBackground}"
                                BorderBrush="{StaticResource NeutralBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="32"
                                Visibility="{Binding HasNoProfiles, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="등록된 서버 프로파일이 없습니다"
                                           FontSize="{StaticResource FontSizeTitle}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource NeutralForeground}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="GitLab / GitHub / Gitea 서버 프로파일을 등록해야 카탈로그를 불러올 수 있습니다."
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{StaticResource NeutralForegroundMuted}"
                                           Margin="0,8,0,12"
                                           HorizontalAlignment="Center" />
                                <Button Content="서버 연결"
                                        Command="{Binding OpenProfileManagementCommand}"
                                        Padding="16,8"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Destination Directory Picker & Execution Bar -->
                    <Border Grid.Row="4"
                            Background="{StaticResource NeutralBackground}"
                            BorderBrush="{StaticResource NeutralBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="클론 대상 기본 루트:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />

                            <TextBox Grid.Column="1"
                                     x:Name="TxtTargetRoot"
                                     AutomationProperties.AutomationId="TxtTargetRoot"
                                     Text="{Binding TargetRootDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,4"
                                     Margin="0,0,8,0"
                                     VerticalContentAlignment="Center"
                                     FontFamily="{StaticResource FontFamilyMono}" />

                            <Button Grid.Column="2"
                                    x:Name="BtnPreviewClone"
                                    AutomationProperties.AutomationId="BtnPreviewClone"
                                    Content="클론 미리보기 및 실행..."
                                    Command="{Binding PreviewAndExecuteCloneCommand}"
                                    IsEnabled="{Binding IsCloning, Converter={StaticResource InverseBool}}"
                                    Padding="16,8"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="이미 클론이 진행 중일 때는 비활성화됩니다." />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar -->
        <StatusBar Grid.Row="2"
                   Background="{StaticResource NeutralSurface}"
                   BorderBrush="{StaticResource NeutralBorder}"
                   BorderThickness="0,1,0,0"
                   Margin="-12,8,-12,-12"
                   Padding="8,4">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatusMessage"
                           AutomationProperties.AutomationId="TxtStatusMessage"
                           Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right" Margin="0,0,4,0">
                <Button Content="⏰ 자동 Pull"
                        AutomationProperties.AutomationId="BtnAutoPullSettingsOpen"
                        Click="BtnAutoPullSettings_Click"
                        Padding="8,2"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right" Margin="0,0,12,0">
                <Button Content="⚙ 설정"
                        AutomationProperties.AutomationId="BtnAppSettingsOpen"
                        Click="BtnAppSettings_Click"
                        Padding="8,2"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="등록된 레포: " Foreground="{StaticResource NeutralForegroundMuted}" />
                    <TextBlock Text="{Binding TotalRepoCount}" FontWeight="Bold" Foreground="{StaticResource NeutralForeground}" />
                    <TextBlock Text="개" Margin="0,0,12,0" Foreground="{StaticResource NeutralForegroundMuted}" />

                    <!-- Background Fetch Progress Indicator -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsFetching, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,8,0">
                        <TextBlock Text="Fetch 중..." FontSize="{StaticResource FontSizeSecondary}" Foreground="{StaticResource NeutralForegroundMuted}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <ProgressBar Width="90" Height="12" IsIndeterminate="True" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Scan Progress -->
                    <ProgressBar Width="90"
                                 Height="12"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
