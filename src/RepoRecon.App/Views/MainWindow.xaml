<Window x:Class="RepoRecon.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RepoRecon.App.ViewModels"
        xmlns:tree="clr-namespace:RepoRecon.App.ViewModels.Tree"
        mc:Ignorable="d"
        Title="RepoRecon (Phase 5)"
        Height="850" Width="1280"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshAllCommand}" />
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllVisibleCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Style for Filter Toggle Buttons -->
        <Style x:Key="FilterToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="BorderBrush" Value="#3B82F6" />
                    <Setter Property="Foreground" Value="#1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style for TreeViewItem to support custom selection & expansion -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding FullPath}" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0E7FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Notice Banners -->
            <RowDefinition Height="*" />    <!-- Main Tabs (Local Management & Clone) -->
            <RowDefinition Height="Auto" /> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- Notification Banners -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <!-- Git Diagnostic Alert Banner -->
            <Border Background="#FDE8E8"
                    BorderBrush="#F98080"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,8"
                    Visibility="{Binding HasGitDiagnosticError, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="⚠️ Git 환경 오류 — 기능이 제한됩니다"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#9B1C1C" />
                    <TextBlock Text="{Binding GitDiagnosticError}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Foreground="#771D1D" />
                </StackPanel>
            </Border>

            <!-- DB Recreated Notice -->
            <Border Background="#FEF08A"
                    BorderBrush="#EAB308"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,0,0,8"
                    Visibility="{Binding WasDatabaseRecreated, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding DatabaseRecreatedNotice}"
                           FontWeight="SemiBold"
                           Foreground="#713F12" />
            </Border>

            <!-- Residual Temp Folders Notice (§7.3, §10 Criterion 21) -->
            <Border x:Name="PanelResidualTempFolders"
                    AutomationProperties.AutomationId="PanelResidualTempFolders"
                    Background="#FEF2F2"
                    BorderBrush="#F87171"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,0,0,8"
                    Visibility="{Binding HasResidualTempFolders, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            x:Name="BtnCleanResidualTempFolders"
                            AutomationProperties.AutomationId="BtnCleanResidualTempFolders"
                            Content="지금 정리하기"
                            Command="{Binding CleanResidualTempFoldersCommand}"
                            Padding="10,4"
                            Margin="12,0,0,0"
                            Background="#FEE2E2"
                            BorderBrush="#FCA5A5"
                            Foreground="#991B1B"
                            FontWeight="Bold"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ResidualTempFoldersNotice}"
                               FontWeight="SemiBold"
                               Foreground="#991B1B"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Authentication host cooldown notice (design v3 §8.4) -->
            <Border x:Name="PanelAuthCooldown"
                    AutomationProperties.AutomationId="PanelAuthCooldown"
                    Background="#FFF7ED"
                    BorderBrush="#FB923C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,0,0,8"
                    Visibility="{Binding HasAuthenticationCooldowns, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            x:Name="BtnRetryAuthCooldown"
                            AutomationProperties.AutomationId="BtnRetryAuthCooldown"
                            Content="지금 재시도"
                            Command="{Binding RefreshAllCommand}"
                            Padding="10,4"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="인증 쿨오프를 즉시 해제하고 다시 스캔·Fetch합니다." />
                    <StackPanel>
                        <TextBlock Text="인증 실패 호스트 재시도 대기"
                                   FontWeight="Bold"
                                   Foreground="#9A3412" />
                        <TextBlock x:Name="TxtAuthCooldownSummary"
                                   AutomationProperties.AutomationId="TxtAuthCooldownSummary"
                                   Text="{Binding AuthenticationCooldownSummary}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   Foreground="#7C2D12" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Background="Transparent"
                    BorderThickness="0">

            <!-- TAB 1: 로컬 관리 -->
            <TabItem Header="📁 로컬 관리"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Padding="16,8"
                     AutomationProperties.AutomationId="TabLocalManagement">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Scan Roots Control Panel (0) -->
                        <RowDefinition Height="Auto" /> <!-- Toolbar / Filters / Execution Bar (1) -->
                        <RowDefinition Height="Auto" /> <!-- Pull Skip Reasons Panel (2) -->
                        <RowDefinition Height="Auto" /> <!-- Push Skip Reasons Panel (3) -->
                        <RowDefinition Height="Auto" /> <!-- Inaccessible Paths Panel (4) -->
                        <RowDefinition Height="*" />    <!-- Main Hierarchical Tree View / Empty State (5) -->
                        <RowDefinition Height="Auto" /> <!-- Pull Execution Panel (6) -->
                        <RowDefinition Height="Auto" /> <!-- Push Execution Panel (7) -->
                    </Grid.RowDefinitions>

                    <!-- Scan Roots Management Panel -->
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Add Row -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="스캔 경로:"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0" />

                                <TextBox Grid.Column="1"
                                         x:Name="TxtScanPath"
                                         AutomationProperties.AutomationId="TxtScanPath"
                                         Text="{Binding NewScanRootPath, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"
                                         Padding="6,4"
                                         Margin="0,0,8,0" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                                    <TextBlock Text="깊이:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Text="{Binding NewScanRootDepth, UpdateSourceTrigger=PropertyChanged}"
                                             Width="40"
                                             VerticalContentAlignment="Center"
                                             Padding="4,4" />
                                </StackPanel>

                                <Button Grid.Column="3"
                                        x:Name="BtnAddScanRoot"
                                        AutomationProperties.AutomationId="BtnAddScanRoot"
                                        Content="루트 추가"
                                        Command="{Binding AddScanRootCommand}"
                                        Padding="12,4"
                                        Margin="0,0,8,0"
                                        Background="#E5E7EB"
                                        BorderBrush="#D1D5DB" />

                                <Button Grid.Column="4"
                                        x:Name="BtnStartScan"
                                        AutomationProperties.AutomationId="BtnStartScan"
                                        Content="스캔 시작"
                                        Command="{Binding StartScanCommand}"
                                        IsEnabled="{Binding IsNotScanning}"
                                        FontWeight="Bold"
                                        Padding="16,4"
                                        Background="#2563EB"
                                        Foreground="White"
                                        BorderBrush="#1D4ED8" />
                            </Grid>

                            <!-- Active Roots List -->
                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{Binding ScanRoots}"
                                          Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F3F4F6"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Margin="0,0,6,4">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding Path}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding MaxDepth, StringFormat=' (깊이:{0})'}"
                                                           FontSize="11"
                                                           Foreground="#6B7280"
                                                           VerticalAlignment="Center" />
                                                <Button Content="✕"
                                                        Command="{Binding DataContext.RemoveScanRootCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="6,0,0,0"
                                                        Padding="2,0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="#9CA3AF"
                                                        Cursor="Hand" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Filter Toolbar & Selection / Execution Bar -->
                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <!-- Right Execution Summary & Pull / Push Execution Buttons -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtExecutionSummary"
                                           AutomationProperties.AutomationId="TxtExecutionSummary"
                                           Text="{Binding ExecutionSummaryText}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />

                                <Button x:Name="BtnExecutePull"
                                        AutomationProperties.AutomationId="BtnExecutePull"
                                        Content="일괄 Pull 실행"
                                        Command="{Binding ExecutePullCommand}"
                                        IsEnabled="{Binding CanExecutePull}"
                                        Padding="12,6"
                                        Margin="0,0,12,0"
                                        Background="#16A34A"
                                        Foreground="White"
                                        BorderBrush="#15803D"
                                        FontWeight="Bold"
                                        Cursor="Hand" />

                                <TextBlock x:Name="TxtPushSelectionSummary"
                                           AutomationProperties.AutomationId="TxtPushSelectionSummary"
                                           Text="{Binding PushExecutionSummaryText}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="4,0,8,0" />

                                <Button x:Name="BtnExecutePush"
                                        AutomationProperties.AutomationId="BtnExecutePush"
                                        Content="🚀 일괄 Push 실행"
                                        Command="{Binding ExecutePushCommand}"
                                        IsEnabled="{Binding CanExecutePush}"
                                        Padding="14,6"
                                        Background="#2563EB"
                                        Foreground="White"
                                        BorderBrush="#1D4ED8"
                                        FontWeight="Bold"
                                        Cursor="Hand" />
                            </StackPanel>

                            <!-- Left: Filter Controls & Fast Actions -->
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="TxtFilter"
                                         AutomationProperties.AutomationId="TxtFilter"
                                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         Width="140"
                                         Padding="4,2"
                                         Margin="0,0,6,0"
                                         ToolTip="폴더명, 브랜치명, 원격 URL 검색" />

                                <ToggleButton Content="Behind만"
                                              x:Name="BtnFilterBehind"
                                              AutomationProperties.AutomationId="BtnFilterBehind"
                                              IsChecked="{Binding FilterBehindOnly, Mode=TwoWay}"
                                              Style="{StaticResource FilterToggleButtonStyle}" />

                                <ToggleButton Content="Ahead만"
                                              IsChecked="{Binding FilterAheadOnly, Mode=TwoWay}"
                                              Style="{StaticResource FilterToggleButtonStyle}" />

                                <ToggleButton Content="Diverged만"
                                              x:Name="BtnFilterDiverged"
                                              AutomationProperties.AutomationId="BtnFilterDiverged"
                                              IsChecked="{Binding FilterDivergedOnly, Mode=TwoWay}"
                                              Style="{StaticResource FilterToggleButtonStyle}" />

                                <ToggleButton Content="Dirty만"
                                              x:Name="BtnFilterDirty"
                                              AutomationProperties.AutomationId="BtnFilterDirty"
                                              IsChecked="{Binding FilterDirtyOnly, Mode=TwoWay}"
                                              Style="{StaticResource FilterToggleButtonStyle}" />

                                <ToggleButton Content="Conflicted만"
                                              IsChecked="{Binding FilterConflictedOnly, Mode=TwoWay}"
                                              Style="{StaticResource FilterToggleButtonStyle}" />

                                <ComboBox ItemsSource="{Binding AvailableHosts}"
                                          SelectedItem="{Binding SelectedHostFilter, Mode=TwoWay}"
                                          Margin="6,0,6,0"
                                          Padding="6,2"
                                          FontSize="12"
                                          Width="110" />

                                <Button Content="전체 선택"
                                        x:Name="BtnSelectAllVisible"
                                        AutomationProperties.AutomationId="BtnSelectAllVisible"
                                        Command="{Binding SelectAllVisibleCommand}"
                                        Padding="8,3"
                                        Margin="2,0"
                                        Background="#F3F4F6"
                                        BorderBrush="#D1D5DB" />

                                <Button Content="선택 해제"
                                        Command="{Binding DeselectAllCommand}"
                                        Padding="8,3"
                                        Margin="2,0"
                                        Background="#F3F4F6"
                                        BorderBrush="#D1D5DB" />

                                <Button Content="새로고침 (F5)"
                                        Command="{Binding RefreshAllCommand}"
                                        Padding="8,3"
                                        Margin="4,0,0,0"
                                        Background="#F3F4F6"
                                        BorderBrush="#D1D5DB" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <!-- Pull Skip Reasons Notice Panel -->
                    <Border Grid.Row="2"
                            Background="#FEF3C7"
                            BorderBrush="#F59E0B"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,4"
                            Margin="0,0,0,6"
                            Visibility="{Binding HasSkipReasons, Converter={StaticResource BoolToVis}}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="{Binding IsSkipDetailsExpanded, Converter={StaticResource BoolToVis}, ConverterParameter='접기|상세보기'}"
                                    Command="{Binding ToggleSkipDetailsCommand}"
                                    Padding="6,1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#B45309"
                                    FontWeight="Bold"
                                    Cursor="Hand" />
                            <TextBlock Text="{Binding SkipReasonSummary, StringFormat='ℹ️ Pull 스킵 안내: {0}'}"
                                       FontWeight="SemiBold"
                                       Foreground="#92400E"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Push Skip Reasons Notice Panel (§7.5, §7.6) -->
                    <Border Grid.Row="3"
                            Background="#EFF6FF"
                            BorderBrush="#93C5FD"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,4"
                            Margin="0,0,0,6"
                            Visibility="{Binding HasPushSkipReasons, Converter={StaticResource BoolToVis}}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="{Binding IsPushSkipDetailsExpanded, Converter={StaticResource BoolToVis}, ConverterParameter='접기|상세보기'}"
                                    Command="{Binding TogglePushSkipDetailsCommand}"
                                    Padding="6,1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#1E40AF"
                                    FontWeight="Bold"
                                    Cursor="Hand" />
                            <TextBlock x:Name="TxtPushSkipBreakdown"
                                       AutomationProperties.AutomationId="TxtPushSkipBreakdown"
                                       Text="{Binding PushSkipReasonSummary, StringFormat='ℹ️ Push 스킵 안내: {0}'}"
                                       FontWeight="SemiBold"
                                       Foreground="#1E3A8A"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Inaccessible Paths Panel -->
                    <Border Grid.Row="4"
                            Background="#FFFBEB"
                            BorderBrush="#FCD34D"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,4"
                            Margin="0,0,0,6"
                            Visibility="{Binding HasInaccessiblePaths, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding IsInaccessiblePathsExpanded, Converter={StaticResource BoolToVis}, ConverterParameter='접기|경로 목록 보기'}"
                                        Command="{Binding ToggleInaccessiblePathsCommand}"
                                        Padding="6,1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#B45309"
                                        FontWeight="Bold"
                                        Cursor="Hand" />
                                <TextBlock Text="⚠️ 접근 거부된 경로가 있어 일부 레포를 건너뛰었습니다."
                                           FontWeight="SemiBold"
                                           Foreground="#B45309"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Main Hierarchical Tree View / Empty State -->
                    <Grid Grid.Row="5">
                        <Border Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6">
                            <TreeView x:Name="MainTreeView"
                                      AutomationProperties.AutomationId="TreeRepos"
                                      ItemsSource="{Binding RootTreeNodes}"
                                      BorderThickness="0"
                                      Padding="4"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.IsDeferredScrollingEnabled="False"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <TreeView.Resources>
                                    <!-- Template for FolderTreeNodeViewModel -->
                                    <HierarchicalDataTemplate DataType="{x:Type tree:FolderTreeNodeViewModel}"
                                                              ItemsSource="{Binding Children}">
                                        <DockPanel Margin="0,2" LastChildFill="True">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />

                                            <!-- Rollup Status Summary Badge -->
                                            <Border DockPanel.Dock="Right"
                                                    Background="#FEF3C7"
                                                    BorderBrush="#FCD34D"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    Margin="8,0,4,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RollupSummaryText}"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Foreground="#92400E" />
                                            </Border>

                                            <!-- Folder Path -->
                                            <TextBlock Text="{Binding CompressedDisplayPath}"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       Foreground="#1F2937"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </HierarchicalDataTemplate>

                                    <!-- Template for RepoTreeNodeViewModel -->
                                    <HierarchicalDataTemplate DataType="{x:Type tree:RepoTreeNodeViewModel}"
                                                              ItemsSource="{Binding Children}">
                                        <DockPanel Margin="0,3" LastChildFill="True">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0" />

                                            <!-- Host profile color dot (●) -->
                                            <TextBlock Text="●"
                                                       Foreground="{Binding HostDotColor}"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"
                                                       ToolTip="{Binding HostName}" />

                                            <!-- Right-aligned Badges: Server Status, Freshness, 3-Axis Summary, Duplicate, Nested Warning -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Server Status Badge (Orphaned / External / Untracked / Archived) (§3.2) -->
                                                <Border Background="#FEF3C7"
                                                        BorderBrush="#F59E0B"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="4,1"
                                                        Margin="4,0"
                                                        Visibility="{Binding HasServerStatusBadge, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding ServerStatusBadge}"
                                                               FontWeight="Bold"
                                                               FontSize="10"
                                                               Foreground="#B45309" />
                                                </Border>

                                                <!-- Nested Repo Boundary Warning -->
                                                <Border Background="#FEE2E2"
                                                        BorderBrush="#F87171"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="4,1"
                                                        Margin="4,0"
                                                        Visibility="{Binding HasGitIgnoreWarning, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="⚠️ .gitignore 누락"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="#991B1B" />
                                                </Border>

                                                <!-- Duplicate Clones Badge -->
                                                <Button Content="{Binding DuplicateBadgeText}"
                                                        Command="{Binding JumpToNextCloneCommand}"
                                                        Background="#EFF6FF"
                                                        BorderBrush="#93C5FD"
                                                        Foreground="#1D4ED8"
                                                        FontWeight="SemiBold"
                                                        FontSize="11"
                                                        Padding="6,1"
                                                        Margin="4,0"
                                                        Cursor="Hand"
                                                        Visibility="{Binding HasDuplicateClones, Converter={StaticResource BoolToVis}}" />

                                                <!-- 3-Axis Status Badge -->
                                                <Border Background="#F3F4F6"
                                                        BorderBrush="#D1D5DB"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="6,2"
                                                        Margin="4,0">
                                                    <TextBlock Text="{Binding ThreeAxisSummary}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               Foreground="#111827" />
                                                </Border>

                                                <!-- Freshness Label -->
                                                <TextBlock Text="{Binding Freshness}"
                                                           Foreground="#6B7280"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0,8,0"
                                                           MinWidth="80"
                                                           TextAlignment="Right" />
                                            </StackPanel>

                                            <!-- Repo Name, Remote Key, Branch -->
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FolderName}"
                                                               FontWeight="Bold"
                                                               FontSize="13"
                                                               Foreground="#111827" />
                                                    <TextBlock Text="{Binding DisplayRepoPath}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="#6B7280"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding BranchDisplay}"
                                                           FontSize="11"
                                                           Foreground="#4B5563"
                                                           Margin="0,1,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </Border>

                        <!-- Empty State Notice -->
                        <Border Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="32"
                                Visibility="{Binding HasNoRepos, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="등록된 저장소가 없습니다"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#374151"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="상단에서 스캔할 폴더 경로를 입력하고 [루트 추가] 후 [스캔 시작]을 누르세요."
                                           FontSize="12"
                                           Foreground="#6B7280"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Pull Execution Panel (Phase 3) -->
                    <Border Grid.Row="6"
                            x:Name="PanelPullExecution"
                            AutomationProperties.AutomationId="PanelPullExecution"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,8,0,0"
                            Visibility="{Binding IsPullPanelVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="120" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        x:Name="BtnCancelPull"
                                        AutomationProperties.AutomationId="BtnCancelPull"
                                        Content="실행 취소"
                                        Command="{Binding CancelPullCommand}"
                                        IsEnabled="{Binding IsPullExecuting}"
                                        Padding="10,3"
                                        Background="#FEE2E2"
                                        BorderBrush="#FCA5A5"
                                        Foreground="#991B1B"
                                        FontWeight="Bold" />
                                <TextBlock Text="🚀 일괄 Pull 실행 진행 상황" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                            </DockPanel>

                            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                <ProgressBar Height="14"
                                             Value="{Binding PullProgressPercent}"
                                             Maximum="100"
                                             Foreground="#2563EB"
                                             Background="#E2E8F0" />
                                <TextBlock Text="{Binding PullProgressText}" FontSize="11" Foreground="#475569" Margin="0,4,0,0" />
                            </StackPanel>

                            <ListBox Grid.Row="2"
                                     x:Name="ListPullExecution"
                                     AutomationProperties.AutomationId="ListPullExecution"
                                     ItemsSource="{Binding PullExecutionItems}"
                                     Background="White"
                                     BorderBrush="#E2E8F0"
                                     BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2,1">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DurationMs, StringFormat='({0}ms)'}" FontSize="10" Foreground="#94A3B8" Margin="6,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontWeight="Bold" FontSize="11" Foreground="{Binding StatusColor}" />
                                            <TextBlock Text="{Binding RepoPath}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Push Execution Panel (§8.2, §8.3) -->
                    <Border Grid.Row="7"
                            x:Name="PanelPushExecution"
                            AutomationProperties.AutomationId="PanelPushExecution"
                            Background="#F8FAFC"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,8,0,0"
                            Visibility="{Binding IsPushPanelVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="120" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        x:Name="BtnCancelPushExecution"
                                        AutomationProperties.AutomationId="BtnCancelPushExecution"
                                        Content="실행 취소"
                                        Command="{Binding CancelPushCommand}"
                                        IsEnabled="{Binding IsPushExecuting}"
                                        Padding="10,3"
                                        Background="#FEE2E2"
                                        BorderBrush="#FCA5A5"
                                        Foreground="#991B1B"
                                        FontWeight="Bold" />
                                <TextBlock Text="🚀 일괄 Push 실행 진행 상황" FontWeight="Bold" FontSize="13" Foreground="#1E3A8A" />
                            </DockPanel>

                            <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                <ProgressBar Height="14"
                                             Value="{Binding PushProgressPercent}"
                                             Maximum="100"
                                             Foreground="#2563EB"
                                             Background="#E2E8F0" />
                                <TextBlock Text="{Binding PushProgressText}" FontSize="11" Foreground="#475569" Margin="0,4,0,0" />
                            </StackPanel>

                            <ListBox Grid.Row="2"
                                     x:Name="ListPushExecution"
                                     AutomationProperties.AutomationId="ListPushExecution"
                                     ItemsSource="{Binding PushExecutionItems}"
                                     Background="White"
                                     BorderBrush="#E2E8F0"
                                     BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2,1">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusBadgeText}" FontWeight="Bold" FontSize="11" Foreground="{Binding StatusBadgeColor}" Margin="6,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="10" Foreground="#64748B" Margin="6,0,0,0" />
                                            <TextBlock Text="{Binding AbsPath}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: 클론 (Phase 4) -->
            <TabItem Header="📥 클론"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Padding="16,8"
                     AutomationProperties.AutomationId="TabClone"
                     DataContext="{Binding CloneTab}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Profile Selection & Actions Bar -->
                        <RowDefinition Height="Auto" /> <!-- Permanent Scan Root Banner -->
                        <RowDefinition Height="Auto" /> <!-- Search, Filter & Multi-select Toolbar -->
                        <RowDefinition Height="*" />    <!-- Catalog DataGrid -->
                        <RowDefinition Height="Auto" /> <!-- Destination Root & Execute Bar -->
                    </Grid.RowDefinitions>

                    <!-- Top Profile Selection & Management Bar -->
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="⚙️ 프로파일 관리..."
                                        x:Name="BtnOpenProfileManagement"
                                        AutomationProperties.AutomationId="BtnOpenProfileManagement"
                                        Command="{Binding OpenProfileManagementCommand}"
                                        Padding="10,5"
                                        Margin="0,0,8,0"
                                        Background="#F1F5F9"
                                        BorderBrush="#CBD5E1"
                                        FontWeight="SemiBold" />

                                <Button Content="🔄 카탈로그 동기화"
                                        x:Name="BtnSyncCatalog"
                                        AutomationProperties.AutomationId="BtnSyncCatalog"
                                        Command="{Binding SyncCatalogCommand}"
                                        IsEnabled="{Binding IsSyncing, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                        Padding="12,5"
                                        Background="#2563EB"
                                        Foreground="White"
                                        BorderBrush="#1D4ED8"
                                        FontWeight="Bold" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="서버 프로파일:"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding ServerProfiles}"
                                          SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                          DisplayMemberPath="Host"
                                          Width="220"
                                          Padding="6,4"
                                          x:Name="CmbCloneProfile"
                                          AutomationProperties.AutomationId="CmbCloneProfile" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Permanent Scan Root Banner (§7.5, §10 Criterion 24) -->
                    <Border Grid.Row="1"
                            Background="#F0FDF4"
                            BorderBrush="#BBF7D0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="0,0,0,8">
                        <TextBlock x:Name="TxtScanRootBanner"
                                   AutomationProperties.AutomationId="TxtScanRootBanner"
                                   Text="{Binding ScanRootBannerText}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="#15803D" />
                    </Border>

                    <!-- Filter & Selection Bar -->
                    <Border Grid.Row="2"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCloneSelectionSummary"
                                           AutomationProperties.AutomationId="TxtCloneSelectionSummary"
                                           Text="{Binding SelectionSummaryText}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                            </StackPanel>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="검색:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="TxtCloneFilter"
                                         AutomationProperties.AutomationId="TxtCloneFilter"
                                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         Width="180"
                                         Padding="4,2"
                                         Margin="0,0,12,0" />

                                <CheckBox x:Name="ChkShowArchived"
                                          AutomationProperties.AutomationId="ChkShowArchived"
                                          Content="보관된(Archived) 레포 표시"
                                          IsChecked="{Binding ShowArchived, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          FontWeight="SemiBold"
                                          Margin="0,0,12,0" />

                                <Button Content="전체 선택"
                                        x:Name="BtnSelectAllCatalog"
                                        AutomationProperties.AutomationId="BtnSelectAllCatalog"
                                        Command="{Binding SelectAllCommand}"
                                        Padding="8,3"
                                        Margin="2,0"
                                        Background="#F3F4F6"
                                        BorderBrush="#D1D5DB" />

                                <Button Content="선택 해제"
                                        x:Name="BtnUnselectAllCatalog"
                                        AutomationProperties.AutomationId="BtnUnselectAllCatalog"
                                        Command="{Binding UnselectAllCommand}"
                                        Padding="8,3"
                                        Margin="2,0"
                                        Background="#F3F4F6"
                                        BorderBrush="#D1D5DB" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <!-- Catalog DataGrid -->
                    <Border Grid.Row="3"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="6">
                        <DataGrid x:Name="GridCatalog"
                                  AutomationProperties.AutomationId="GridCatalog"
                                  ItemsSource="{Binding FilteredCatalogItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <!-- Checkbox Column -->
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Namespace / Name -->
                                <DataGridTemplateColumn Header="네임스페이스 / 저장소" Width="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Repo.NormalizedKey}" FontWeight="Bold" Foreground="#0F172A" />
                                                <TextBlock Text="{Binding Repo.Namespace, StringFormat='네임스페이스: {0}'}" FontSize="10" Foreground="#64748B" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Default Branch -->
                                <DataGridTextColumn Header="기본 브랜치"
                                                    Binding="{Binding Repo.DefaultBranch}"
                                                    Width="110" />

                                <!-- Status / Badges Column -->
                                <DataGridTemplateColumn Header="상태 배지" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Archived Badge -->
                                                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                                                        CornerRadius="3" Padding="4,1" Margin="0,0,4,0"
                                                        Visibility="{Binding IsArchived, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="보관됨" FontSize="10" FontWeight="Bold" Foreground="#991B1B" />
                                                </Border>

                                                <!-- Already Cloned Jump Link/Badge (§5.2, §10 Criterion 24) -->
                                                <Button Content="{Binding AlreadyClonedBadgeText}"
                                                        Command="{Binding DataContext.JumpToLocalRepoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#EFF6FF" BorderBrush="#93C5FD"
                                                        Foreground="#1D4ED8" FontWeight="Bold" FontSize="11"
                                                        Padding="6,2" Margin="0,0,4,0" Cursor="Hand"
                                                        Visibility="{Binding IsAlreadyCloned, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="클릭 시 로컬 탭 해당 레포 노드로 이동합니다" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Clone URL -->
                                <DataGridTextColumn Header="Clone URL (토큰 미포함)"
                                                    Binding="{Binding Repo.CloneUrl}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Destination Directory Picker & Execution Bar -->
                    <Border Grid.Row="4"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="클론 대상 기본 루트:"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />

                            <TextBox Grid.Column="1"
                                     x:Name="TxtTargetRoot"
                                     AutomationProperties.AutomationId="TxtTargetRoot"
                                     Text="{Binding TargetRootDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4"
                                     Margin="0,0,8,0"
                                     VerticalContentAlignment="Center" />

                            <Button Grid.Column="2"
                                    x:Name="BtnPreviewClone"
                                    AutomationProperties.AutomationId="BtnPreviewClone"
                                    Content="클론 미리보기 및 실행..."
                                    Command="{Binding PreviewAndExecuteCloneCommand}"
                                    IsEnabled="{Binding IsCloning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                    Padding="16,6"
                                    Background="#2563EB"
                                    Foreground="White"
                                    BorderBrush="#1D4ED8"
                                    FontWeight="Bold"
                                    Cursor="Hand" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar -->
        <StatusBar Grid.Row="2"
                   Background="#F3F4F6"
                   BorderBrush="#E5E7EB"
                   BorderThickness="0,1,0,0"
                   Margin="-12,8,-12,-12"
                   Padding="8,4">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatusMessage"
                           AutomationProperties.AutomationId="TxtStatusMessage"
                           Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="등록된 레포: " Foreground="#6B7280" />
                    <TextBlock Text="{Binding TotalRepoCount}" FontWeight="Bold" Foreground="#111827" />
                    <TextBlock Text="개" Margin="0,0,12,0" Foreground="#6B7280" />

                    <!-- Background Fetch Progress Indicator -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsFetching, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,8,0">
                        <TextBlock Text="Fetch 중..." FontSize="11" Foreground="#4B5563" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <ProgressBar Width="90" Height="12" IsIndeterminate="True" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Scan Progress -->
                    <ProgressBar Width="90"
                                 Height="12"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
