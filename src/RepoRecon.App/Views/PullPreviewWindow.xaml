<Window x:Class="RepoRecon.App.Views.PullPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RepoRecon.App.ViewModels"
        mc:Ignorable="d"
        Title="일괄 Pull 실행 전 미리보기 (Dry-Run)"
        AutomationProperties.AutomationId="DialogPullPreview"
        Height="600" Width="850"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Background="#F9FAFB">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Summary -->
            <RowDefinition Height="*" />    <!-- Content Lists -->
            <RowDefinition Height="Auto" /> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="🚀 일괄 Pull 실행 전 미리보기 (Dry-Run)"
                           FontWeight="Bold"
                           FontSize="16"
                           Foreground="#111827" />
                <TextBlock Text="실제 디스크 및 Git 변경이 적용되기 전, 실행 대상과 스킵 사유를 확인하세요."
                           Foreground="#6B7280"
                           Margin="0,4,0,8" />
                <Border Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,6">
                    <TextBlock AutomationProperties.AutomationId="TxtPreviewSummary"
                               Text="{Binding SummaryText}"
                               FontWeight="SemiBold"
                               Foreground="#1E40AF" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Lists (TabControl or Dual Sections) -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#E5E7EB" Margin="0,0,0,12">
            <!-- Eligible Tab -->
            <TabItem Header="실행 대상" AutomationProperties.AutomationId="TabEligibleRepos">
                <Grid Margin="8">
                    <DataGrid AutomationProperties.AutomationId="GridEligibleRepos"
                              ItemsSource="{Binding EligibleItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F3F4F6"
                              BorderThickness="0"
                              Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="로컬 경로" Binding="{Binding AbsPath}" Width="2*" />
                            <DataGridTextColumn Header="브랜치 → Upstream" Binding="{Binding Branch, StringFormat='{}{0}'}" Width="150" />
                            <DataGridTextColumn Header="Behind" Binding="{Binding Behind, StringFormat='+{0}'}" Width="70" />
                            <DataGridTextColumn Header="실행 명령" Binding="{Binding Command}" Width="2.5*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Skipped Tab -->
            <TabItem Header="스킵 대상" AutomationProperties.AutomationId="TabSkippedRepos">
                <Grid Margin="8">
                    <DataGrid AutomationProperties.AutomationId="GridSkippedRepos"
                              ItemsSource="{Binding SkippedItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F3F4F6"
                              BorderThickness="0"
                              Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="로컬 경로" Binding="{Binding AbsPath}" Width="2*" />
                            <DataGridTextColumn Header="스킵 사유" Binding="{Binding SkipReason}" Width="2*" />
                            <DataGridTextColumn Header="현재 상태" Binding="{Binding Branch}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Action Buttons -->
        <DockPanel Grid.Row="2" LastChildFill="False">
            <TextBlock Text="※ 확인 버튼을 누르기 전에는 어떠한 로컬 파일도 변경되지 않습니다."
                       VerticalAlignment="Center"
                       Foreground="#6B7280"
                       FontSize="11"
                       DockPanel.Dock="Left" />

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="취소"
                        AutomationProperties.AutomationId="BtnCancelPull"
                        IsCancel="True"
                        Padding="16,6"
                        Margin="0,0,8,0"
                        Background="#F3F4F6"
                        BorderBrush="#D1D5DB"
                        Command="{Binding CancelCommand}" />

                <Button Content="확인 및 실행"
                        AutomationProperties.AutomationId="BtnConfirmPull"
                        IsDefault="True"
                        Padding="18,6"
                        FontWeight="Bold"
                        Background="#1D4ED8"
                        Foreground="White"
                        BorderBrush="#1D4ED8"
                        Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
