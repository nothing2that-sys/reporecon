<Window x:Class="RepoRecon.App.Views.PullPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RepoRecon.App.ViewModels"
        mc:Ignorable="d"
        Title="일괄 Pull 실행 전 미리보기 (Dry-Run)"
        AutomationProperties.AutomationId="DialogPullPreview"
        Height="600" Width="850"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource NeutralSurface}"
        FontFamily="{StaticResource FontFamilyDefault}"
        Foreground="{StaticResource NeutralForeground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Summary -->
            <RowDefinition Height="*" />    <!-- Content Lists -->
            <RowDefinition Height="Auto" /> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource NeutralBackground}"
                BorderBrush="{StaticResource NeutralBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="🚀 일괄 Pull 실행 전 미리보기 (Dry-Run)"
                           FontWeight="Bold"
                           FontSize="{StaticResource FontSizeTitle}"
                           Foreground="{StaticResource NeutralForeground}" />
                <TextBlock Text="실제 디스크 및 Git 변경이 적용되기 전, 실행 대상과 스킵 사유를 확인하세요."
                           Foreground="{StaticResource NeutralForegroundMuted}"
                           Margin="0,4,0,8" />
                <Border Background="{StaticResource InfoBackground}"
                        BorderBrush="{StaticResource InfoBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8">
                    <TextBlock AutomationProperties.AutomationId="TxtPreviewSummary"
                               Text="{Binding SummaryText}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InfoForeground}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Lists (TabControl or Dual Sections) -->
        <TabControl Grid.Row="1" Background="{StaticResource NeutralBackground}" BorderBrush="{StaticResource NeutralBorder}" Margin="0,0,0,12">
            <!-- Eligible Tab -->
            <TabItem Header="실행 대상" AutomationProperties.AutomationId="TabEligibleRepos">
                <Grid Margin="8">
                    <DataGrid AutomationProperties.AutomationId="GridEligibleRepos"
                              ItemsSource="{Binding EligibleItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource NeutralSurface}"
                              BorderThickness="0"
                              Background="{StaticResource NeutralBackground}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="로컬 경로" Binding="{Binding AbsPath, Converter={StaticResource FrontEllipsis}, ConverterParameter=48}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
                                        <Setter Property="ToolTip" Value="{Binding AbsPath}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="브랜치 → Upstream" Binding="{Binding Branch, StringFormat='{}{0}'}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Behind" Binding="{Binding Behind, StringFormat='+{0}'}" Width="70" />
                            <DataGridTextColumn Header="실행 명령" Binding="{Binding Command}" Width="2.5*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Skipped Tab -->
            <TabItem Header="스킵 대상" AutomationProperties.AutomationId="TabSkippedRepos">
                <Grid Margin="8">
                    <DataGrid AutomationProperties.AutomationId="GridSkippedRepos"
                              ItemsSource="{Binding SkippedItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource NeutralSurface}"
                              BorderThickness="0"
                              Background="{StaticResource NeutralBackground}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="로컬 경로" Binding="{Binding AbsPath, Converter={StaticResource FrontEllipsis}, ConverterParameter=48}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
                                        <Setter Property="ToolTip" Value="{Binding AbsPath}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="스킵 사유" Binding="{Binding SkipReason}" Width="2*" />
                            <DataGridTextColumn Header="현재 상태" Binding="{Binding Branch}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Action Buttons -->
        <DockPanel Grid.Row="2" LastChildFill="False">
            <TextBlock Text="※ 확인 버튼을 누르기 전에는 어떠한 로컬 파일도 변경되지 않습니다."
                       VerticalAlignment="Center"
                       Foreground="{StaticResource NeutralForegroundMuted}"
                       FontSize="{StaticResource FontSizeSecondary}"
                       DockPanel.Dock="Left" />

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="취소"
                        AutomationProperties.AutomationId="BtnCancelPull"
                        IsCancel="True"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}" />

                <Button Content="확인 및 실행"
                        AutomationProperties.AutomationId="BtnConfirmPull"
                        IsDefault="True"
                        Padding="16,8"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
