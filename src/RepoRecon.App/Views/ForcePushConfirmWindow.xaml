<Window x:Class="RepoRecon.App.Views.ForcePushConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="개별 Force Push 확인"
        Height="340" Width="560"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="DialogForcePushConfirm"
        Background="#F8FAFC">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Warning Header -->
        <Border Grid.Row="0"
                Background="#FEF2F2"
                BorderBrush="#FCA5A5"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="🚨 원격 브랜치 덮어쓰기 (--force-with-lease)" FontWeight="Bold" FontSize="13" Foreground="#991B1B" />
                <TextBlock Text="개별 레포지토리에 대해 안전한 강제 푸시(--force-with-lease)를 실행합니다. 원격에 새로운 커밋이 추가되어 있으면 자동으로 거부됩니다." FontSize="11" Foreground="#7F1D1D" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Details -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="대상 저장소:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtTargetPath" AutomationProperties.AutomationId="TxtForcePushTargetPath" TextTrimming="CharacterEllipsis" Foreground="#1E293B" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="체크아웃 브랜치:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtBranch" AutomationProperties.AutomationId="TxtForcePushBranch" FontWeight="Bold" Foreground="#1D4ED8" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="덮어쓸 원격 커밋:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtRemoteCommit" AutomationProperties.AutomationId="TxtForcePushRemoteCommit" FontFamily="Consolas" FontWeight="Bold" Foreground="#DC2626" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bottom Buttons -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right"
                    x:Name="BtnConfirmForcePush"
                    AutomationProperties.AutomationId="BtnConfirmForcePush"
                    Content="Force Push 실행"
                    Click="BtnConfirm_Click"
                    Padding="16,6"
                    Background="#DC2626"
                    Foreground="White"
                    BorderBrush="#B91C1C"
                    FontWeight="Bold"
                    Cursor="Hand" />

            <Button DockPanel.Dock="Right"
                    x:Name="BtnCancelForcePush"
                    AutomationProperties.AutomationId="BtnCancelForcePush"
                    Content="취소"
                    Click="BtnCancel_Click"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    Background="#F1F5F9"
                    BorderBrush="#CBD5E1" />
        </DockPanel>
    </Grid>
</Window>
