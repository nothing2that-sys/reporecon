<Window x:Class="RepoRecon.App.Views.ForcePushConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="개별 Force Push 확인"
        Height="340" Width="560"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="DialogForcePushConfirm"
        Background="{StaticResource NeutralSurface}"
        FontFamily="{StaticResource FontFamilyDefault}"
        Foreground="{StaticResource NeutralForeground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Warning Header -->
        <Border Grid.Row="0"
                Background="{StaticResource ErrorBackground}"
                BorderBrush="{StaticResource ErrorBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="🚨 원격 브랜치 덮어쓰기 (--force-with-lease)" FontWeight="Bold" FontSize="{StaticResource FontSizeSubtitle}" Foreground="{StaticResource ErrorForeground}" />
                <TextBlock Text="개별 레포지토리에 대해 안전한 강제 푸시(--force-with-lease)를 실행합니다. 원격에 새로운 커밋이 추가되어 있으면 자동으로 거부됩니다." FontSize="{StaticResource FontSizeSecondary}" Foreground="{StaticResource ErrorForeground}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Details -->
        <Border Grid.Row="1"
                Background="{StaticResource NeutralBackground}"
                BorderBrush="{StaticResource NeutralBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="대상 저장소:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtTargetPath" AutomationProperties.AutomationId="TxtForcePushTargetPath"
                               FontFamily="{StaticResource FontFamilyMono}" Foreground="{StaticResource NeutralForeground}" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="체크아웃 브랜치:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtBranch" AutomationProperties.AutomationId="TxtForcePushBranch" FontFamily="{StaticResource FontFamilyMono}" FontWeight="Bold" Foreground="{StaticResource InfoForeground}" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="덮어쓸 원격 커밋:" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="TxtRemoteCommit" AutomationProperties.AutomationId="TxtForcePushRemoteCommit" FontFamily="{StaticResource FontFamilyMono}" FontWeight="Bold" Foreground="{StaticResource ErrorForeground}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bottom Buttons: 위험 동작이므로 기본 버튼은 취소 쪽 (§5-1) -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right"
                    x:Name="BtnConfirmForcePush"
                    AutomationProperties.AutomationId="BtnConfirmForcePush"
                    Content="Force Push 실행"
                    Click="BtnConfirm_Click"
                    Padding="16,8"
                    Style="{StaticResource DangerButtonStyle}" />

            <Button DockPanel.Dock="Right"
                    x:Name="BtnCancelForcePush"
                    AutomationProperties.AutomationId="BtnCancelForcePush"
                    Content="취소"
                    Click="BtnCancel_Click"
                    IsCancel="True"
                    IsDefault="True"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
