<Window x:Class="RepoRecon.App.Views.ChangeRemoteUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RepoRecon.App.ViewModels"
        mc:Ignorable="d"
        Title="Remote URL 변경"
        Height="420" Width="640"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="DialogChangeRemoteUrl"
        Background="{StaticResource NeutralSurface}"
        FontFamily="{StaticResource FontFamilyDefault}"
        Foreground="{StaticResource NeutralForeground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Target Path & Notice -->
            <RowDefinition Height="*" />    <!-- Input Fields & Previews -->
            <RowDefinition Height="Auto" /> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header / Path Info -->
        <Border Grid.Row="0"
                Background="{StaticResource NeutralBackground}"
                BorderBrush="{StaticResource NeutralBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="🔗 원격 저장소 Remote URL 변경" FontWeight="Bold" FontSize="{StaticResource FontSizeSubtitle}" Foreground="{StaticResource NeutralForeground}" />
                <TextBlock Text="{Binding RepoPath, Converter={StaticResource FrontEllipsis}, ConverterParameter=60, StringFormat='대상 경로: {0}'}"
                           ToolTip="{Binding RepoPath}"
                           FontFamily="{StaticResource FontFamilyMono}"
                           FontSize="{StaticResource FontSizeSecondary}" Foreground="{StaticResource NeutralForegroundMuted}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Main Form -->
        <Border Grid.Row="1"
                Background="{StaticResource NeutralBackground}"
                BorderBrush="{StaticResource NeutralBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16">
            <StackPanel Orientation="Vertical">
                <!-- Remote Name -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="대상 Remote:" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             x:Name="TxtRemoteName"
                             AutomationProperties.AutomationId="TxtRemoteName"
                             Text="{Binding RemoteName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,4"
                             TabIndex="0" />
                </Grid>

                <!-- Current URL -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="현재 URL:" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               x:Name="TxtCurrentUrl"
                               AutomationProperties.AutomationId="TxtCurrentUrl"
                               Text="{Binding CurrentUrl}"
                               FontFamily="{StaticResource FontFamilyMono}"
                               Foreground="{StaticResource NeutralForegroundMuted}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>

                <!-- New URL Input -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="새 Remote URL:" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             x:Name="TxtNewUrl"
                             AutomationProperties.AutomationId="TxtNewUrl"
                             Text="{Binding NewUrl, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource FontFamilyMono}"
                             Padding="8,4"
                             Margin="0,0,8,0"
                             TabIndex="1" />
                    <Button Grid.Column="2"
                            x:Name="BtnCheckReachability"
                            AutomationProperties.AutomationId="BtnCheckReachability"
                            Content="접근성 검사"
                            Command="{Binding CheckReachabilityCommand}"
                            IsEnabled="{Binding IsCheckingReachability, Converter={StaticResource InverseBool}}"
                            Padding="12,4"
                            Background="{StaticResource NeutralSurface}"
                            BorderBrush="{StaticResource NeutralBorder}"
                            FontWeight="SemiBold"
                            TabIndex="2"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="이미 검사가 진행 중일 때는 비활성화됩니다." />
                </Grid>

                <!-- Pre-save Mapping Reevaluation Preview (§10.7-a, Criterion 18) -->
                <Border Background="{StaticResource NeutralSurface}"
                        BorderBrush="{StaticResource NeutralBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="사전 매핑 재판정 결과 (저장 전 미리보기):" FontWeight="Bold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{StaticResource NeutralForeground}" />
                        <TextBlock x:Name="TxtReevaluatedMapping"
                                   AutomationProperties.AutomationId="TxtReevaluatedMapping"
                                   Text="{Binding ReevaluatedMappingStatus}"
                                   Foreground="{Binding ReevaluatedMappingColor}"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Reachability Status -->
                <Border Background="{StaticResource NeutralSurface}"
                        BorderBrush="{StaticResource NeutralBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="원격 도달 가능성 검증 (ls-remote):" FontWeight="Bold" FontSize="{StaticResource FontSizeSecondary}" Foreground="{StaticResource NeutralForeground}" />
                        <TextBlock x:Name="TxtReachabilityStatus"
                                   AutomationProperties.AutomationId="TxtReachabilityStatus"
                                   Text="{Binding ReachabilityStatus}"
                                   Foreground="{Binding ReachabilityStatusColor}"
                                   FontSize="{StaticResource FontSizeSecondary}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Bottom Action Buttons -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right"
                    x:Name="BtnSaveRemoteUrl"
                    AutomationProperties.AutomationId="BtnSaveRemoteUrl"
                    Content="저장 및 적용"
                    Click="BtnSave_Click"
                    IsEnabled="{Binding CanSave}"
                    IsDefault="True"
                    Padding="16,8"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTip="새 URL이 비어있거나 현재 URL과 같으면 비활성화됩니다." />

            <Button DockPanel.Dock="Right"
                    x:Name="BtnCancelRemoteUrl"
                    AutomationProperties.AutomationId="BtnCancelRemoteUrl"
                    Content="취소"
                    Click="BtnCancel_Click"
                    IsCancel="True"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
